+/*
+ * An opaque page that only an animated translate moves is moved by copying its pixels: a sheet sliding
+ * in over a screen, then out past the edge. Every frame must match a full repaint of the same scene,
+ * with a node inside the page changing, one removed from it, a node beneath it changing and an overlay
+ * painted above it; and the slide must repaint far less than the page. A translucent page cannot be
+ * moved that way and must still match.
+ */
+
+#include "er_scene.h"
+#include "native_renderer.h"
+#include "renderer_internal.h"
+#include "software_backend.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define FB_W 320
+#define FB_H 180
+#define FRAME_MS 16
+#define FRAMES 40 /* both slides, settled frames included */
+
+const EmbeddedRenderBackend* er_backend(void);
+
+static EmbeddedRenderBackend g_inner, g_counting;
+static long g_painted_px = 0;
+static int g_moves = 0;
+static uint32_t g_frames[FRAMES][FB_W * FB_H];
+
+static void fill_cb(uint32_t argb, int x, int y, int w, int h, void* ctx)
+{
+    g_inner.fill_rect(argb, x, y, w, h, ctx);
+    g_painted_px += (long)w * h;
+}
+
+static void copy_cb(const void* src, int stride, int x, int y, int w, int h, void* ctx)
+{
+    g_inner.copy_rect(src, stride, x, y, w, h, ctx);
+    g_painted_px += (long)w * h;
+}
+
+static void blend_cb(const void* src, int stride, uint8_t alpha, int x, int y, int w, int h, void* ctx)
+{
+    g_inner.blend_rect(src, stride, alpha, x, y, w, h, ctx);
+    g_painted_px += (long)w * h;
+}
+
+static void move_cb(int sx, int sy, int w, int h, int dx, int dy, void* ctx)
+{
+    g_inner.move_rect(sx, sy, w, h, dx, dy, ctx);
+    g_moves++;
+}
+
+static ERNode* node(ERNode* parent, int left, int top, int w, int h, uint32_t bg)
+{
+    ERNode* n = er_node_create(ER_NODE_VIEW);
+    ERProps p;
+    er_props_default(&p);
+    p.position = ER_POS_ABSOLUTE;
+    p.left = (int16_t)left;
+    p.top = (int16_t)top;
+    p.width = (int16_t)w;
+    p.height = (int16_t)h;
+    p.background_color = bg;
+    er_node_set_props(n, &p);
+    if (parent)
+        er_tree_append_child(parent, n);
+    return n;
+}
+
+static void set_color(ERNode* n, int left, int top, int w, int h, uint32_t bg)
+{
+    ERProps p;
+    er_props_default(&p);
+    p.position = ER_POS_ABSOLUTE;
+    p.left = (int16_t)left;
+    p.top = (int16_t)top;
+    p.width = (int16_t)w;
+    p.height = (int16_t)h;
+    p.background_color = bg;
+    er_node_set_props(n, &p);
+}
+
+/**
+ * @brief Slides a sheet in from 120 px right, changes things around it, then slides it 200 px out.
+ *
+ * @param[in] full        Repaint the whole screen every frame (the reference).
+ * @param[in] page_color  The page's background; translucent pages cannot be moved by copy.
+ * @param[in] check       Compare each frame with the reference stored by an earlier full run.
+ *
+ * @return Pixels painted over the sliding-in frames.
+ */
+static long run(bool full, uint32_t page_color, bool check, const char* what, int* failures)
+{
+    er_reset();
+    embedded_renderer_set_backend(&g_counting);
+    ERNode* root = node(NULL, 0, 0, FB_W, FB_H, 0xFF203040U);
+    ERNode* under = node(root, 10, 20, 60, 40, 0xFF40A060U); /* beneath, half covered at the start */
+    node(root, 200, 120, 80, 30, 0xFFA04060U);
+    ERNode* sheet = node(root, 0, 0, FB_W, FB_H, 0);
+    ERNode* wrapper = node(sheet, 0, 0, FB_W, FB_H, 0);
+    ERNode* page = node(wrapper, 0, 0, FB_W, FB_H, page_color);
+    node(page, 20, 30, 100, 20, 0xFFE0E0E0U);
+    ERNode* badge = node(page, 40, 100, 50, 50, 0xFF3060C0U);
+    ERNode* gone = node(page, 200, 40, 60, 30, 0xFFC0A030U);
+    node(root, 150, 60, 40, 80, 0xC0FFFFFFU); /* translucent overlay above the sheet */
+    er_tree_set_root(root);
+
+    const ERAnimValueHandle slide = er_anim_value_create(120.0f);
+    er_anim_value_bind(slide, sheet, ER_PROP_TRANSLATE_X);
+    er_force_full_repaint();
+    er_commit();
+
+    ERAnimConfig cfg = {0};
+    cfg.type = ER_ANIM_TIMING;
+    cfg.duration_ms = 240;
+    cfg.easing = ER_EASE_LINEAR;
+    er_anim_value_animate(slide, 0.0f, &cfg);
+    long painted_in = 0;
+    for (int f = 0; f < FRAMES; f++)
+    {
+        if (f == 4)
+            set_color(badge, 40, 100, 50, 50, 0xFFC03060U);
+        if (f == 6)
+            set_color(under, 10, 20, 60, 40, 0xFF6040A0U);
+        if (f == 8)
+            er_tree_remove_child(page, gone);
+        if (f == 20)
+            er_anim_value_animate(slide, 200.0f, &cfg);
+        embedded_renderer_tick(FRAME_MS);
+        if (full)
+            er_force_full_repaint();
+        g_painted_px = 0;
+        er_commit();
+        if (f < 16)
+            painted_in += g_painted_px;
+        if (!check)
+            memcpy(g_frames[f], er_software_framebuffer(), sizeof(g_frames[f]));
+        else if (memcmp(g_frames[f], er_software_framebuffer(), sizeof(g_frames[f])) != 0)
+        {
+            fprintf(stderr, "FAIL %s: frame %d differs from a full repaint\n", what, f);
+            (*failures)++;
+            break;
+        }
+    }
+    er_anim_value_destroy(slide);
+    return painted_in;
+}
+
+int main(void)
+{
+    if (!er_software_backend_init(FB_W, FB_H))
+        return 1;
+    g_inner = *er_backend();
+    g_counting = g_inner;
+    g_counting.fill_rect = fill_cb;
+    g_counting.copy_rect = copy_cb;
+    g_counting.blend_rect = blend_cb;
+    g_counting.move_rect = move_cb;
+
+    int failures = 0;
+    const long full_px = run(true, 0xFF101820U, false, "opaque page", &failures);
+    g_moves = 0;
+    const long moved_px = run(false, 0xFF101820U, true, "opaque page", &failures);
+    if (g_moves < 10)
+    {
+        fprintf(stderr, "FAIL opaque page: moved by copy on %d frames\n", g_moves);
+        failures++;
+    }
+    /* Copying leaves the uncovered strips, the changes and the overlay to paint: far below the page. */
+    if (moved_px * 4 > full_px)
+    {
+        fprintf(stderr, "FAIL opaque page: the slide painted %ld px, a full repaint %ld\n", moved_px, full_px);
+        failures++;
+    }
+
+    run(true, 0xE0101820U, false, "translucent page", &failures);
+    g_moves = 0;
+    run(false, 0xE0101820U, true, "translucent page", &failures);
+    if (g_moves != 0)
+    {
+        fprintf(stderr, "FAIL translucent page: moved by copy on %d frames\n", g_moves);
+        failures++;
+    }
+    return failures ? EXIT_FAILURE : EXIT_SUCCESS;
+}
