+static bool paints_before(const ERNode* a, const ERNode* b);
+
+/* Containers between a translated node and the opaque page it carries, at most. */
+#define ER_TRANSLATE_COPY_CHAIN 6
+/* Nodes painted over a moved page that can be repainted around the copy, at most. */
+#define ER_TRANSLATE_COPY_FOREIGN_MAX 16
+
+/** @brief Damages and reports @p a minus @p b: up to four rects around their intersection. */
+static void damage_difference(ERDamageSet* dmg, ERRect a, ERRect b, int rb_x0, int rb_y0, int rb_x1, int rb_y1)
+{
+    int ix = b.x, iy = b.y, iw = b.w, ih = b.h;
+    if (!rect_intersect(&ix, &iy, &iw, &ih, a.x, a.y, a.w, a.h))
+    {
+        add_damage(dmg, a.x, a.y, a.w, a.h, rb_x0, rb_y0, rb_x1, rb_y1);
+        report_repaint_clamped(a.x, a.y, a.w, a.h, rb_x0, rb_y0, rb_x1, rb_y1);
+        return;
+    }
+    const int parts[4][4] = {{a.x, a.y, a.w, iy - a.y},
+                             {a.x, iy + ih, a.w, a.y + a.h - (iy + ih)},
+                             {a.x, iy, ix - a.x, ih},
+                             {ix + iw, iy, a.x + a.w - (ix + iw), ih}};
+    for (int i = 0; i < 4; i++)
+        if (parts[i][2] > 0 && parts[i][3] > 0)
+        {
+            add_damage(dmg, parts[i][0], parts[i][1], parts[i][2], parts[i][3], rb_x0, rb_y0, rb_x1, rb_y1);
+            report_repaint_clamped(parts[i][0], parts[i][1], parts[i][2], parts[i][3], rb_x0, rb_y0, rb_x1, rb_y1);
+        }
+}
+
+/** @brief Whether @p n is @p ancestor or lies under it. */
+static bool node_within(const ERNode* n, const ERNode* ancestor)
+{
+    for (; n; n = er_get_node(n->parent_tag))
+        if (n == ancestor)
+            return true;
+    return false;
+}
+
+/** @brief The node's screen footprint clipped like last_paint_rect records it; false under a complex transform. */
+static bool recorded_rect(const ERNode* n, ERRect* out)
+{
+    int x, y, w, h;
+    if (!node_screen_rect(n, &x, &y, &w, &h))
+        return false;
+    clip_rect_axis(&x, &w);
+    clip_rect_axis(&y, &h);
+    out->x = x;
+    out->y = y;
+    out->w = w;
+    out->h = h;
+    return true;
+}
+
+/**
+ * @brief Moves the pixels of a page that only an animated translate moved, instead of repainting it.
+ *
+ * A sheet sliding over the screen otherwise repaints its whole box, and what it uncovers, on every frame.
+ * Moving is exact when everything the translated node paints is an opaque, plain page (the node itself
+ * or the end of a chain of single, paint-free children) and lies inside it: the page's pixels then
+ * depend on nothing beneath it. What the move cannot carry is damaged instead: the strips of the page
+ * it uncovers, the area the page left, nodes painted over it, and the moved copies of footprints that
+ * were vacated inside it. Descendants that changed this commit are damaged by the pre-pass at their
+ * moved footprints, as for a scroll.
+ *
+ * @param[in,out] t                        Node whose translate is all that changed since it was painted.
+ * @param[in,out] dmg                      The commit's damage set.
+ * @param[in]     rb_x0,rb_y0,rb_x1,rb_y1  Root bounds the damage and the reported rects are clamped to.
+ *
+ * @return true when the pixels were moved (or did not move at all); false to repaint as usual.
+ */
+static bool translate_by_copy(ERNode* t, ERDamageSet* dmg, int rb_x0, int rb_y0, int rb_x1, int rb_y1)
+{
+    if (s_display_buffer_count != 1 || !er_blit_can_move() || s_kbd_avoid_y != 0)
+        return false;
+    if (t->subtree_hidden || !t->has_last_paint || t->overflow_toggled || !node_translates_subtree(t))
+        return false;
+    ERRect now;
+    if (!recorded_rect(t, &now) || now.w != t->last_paint_rect.w || now.h != t->last_paint_rect.h
+        || spans_paint_window(now.x, now.y, now.w, now.h))
+        return false;
+    const int mx = now.x - t->last_paint_rect.x, my = now.y - t->last_paint_rect.y;
+
+    /* The page: an opaque plain container at the end of a chain of single, paint-free containers. */
+    ERNode* page = t;
+    for (int depth = 0;; depth++)
+    {
+        int border, radius;
+        if (depth == ER_TRANSLATE_COPY_CHAIN || !is_plain_container(page, &border, &radius))
+            return false;
+        if (page != t && page->has_transform)
+            return false;
+        if ((page->props.view.background_color >> 24) == 0xFFU && border == 0 && radius == 0
+            && page->type == ER_NODE_VIEW)
+            break;
+        if (!paints_nothing(page) || node_clips_children(page))
+            return false;
+        uint16_t only[2];
+        if (er_collect_children(page, only, 2) != 1)
+            return false;
+        page = er_get_node(only[0]);
+        if (!page || page->layout.display == ER_DISPLAY_NONE)
+            return false;
+    }
+    /* Everything under the page paints inside it, or the move would carry pixels composited over what
+     * lies beneath. */
+    if (!node_clips_children(page))
+    {
+        int sx, sy, sw, sh, px, py, pw, ph;
+        if (!s_prune_ok || !node_subtree_screen_rect(t, &sx, &sy, &sw, &sh)
+            || !node_screen_rect(page, &px, &py, &pw, &ph) || sx < px || sy < py || sx + sw > px + pw
+            || sy + sh > py + ph)
+            return false;
+    }
+    /* Seen through ancestors that blend or transform it, the page is not alone in its pixels. */
+    for (const ERNode* a = er_get_node(t->parent_tag); a; a = er_get_node(a->parent_tag))
+        if (a->has_transform
+            || ((a->type == ER_NODE_VIEW || a->type == ER_NODE_SCROLL_VIEW || a->type == ER_NODE_PRESSABLE
+                 || a->type == ER_NODE_FLAT_LIST)
+                && a->props.view.opacity != 255U))
+            return false;
+
+    ERRect page_now;
+    if (!page->has_last_paint || !recorded_rect(page, &page_now) || page->last_paint_rect.w != page_now.w
+        || page->last_paint_rect.h != page_now.h || page->last_paint_rect.x != page_now.x - mx
+        || page->last_paint_rect.y != page_now.y - my)
+        return false; /* the page was not painted where the move assumes */
+    if (mx == 0 && my == 0)
+    {
+        t->source_dirty = false; /* a sub-pixel translate lands on the same pixels */
+        return true;
+    }
+
+    /* Visible before and after: the page's box inside its clippers and the root. */
+    int nx = page_now.x, ny = page_now.y, nw = page_now.w, nh = page_now.h;
+    clip_rect_to_clippers(page, &nx, &ny, &nw, &nh);
+    int ox = page_now.x - mx, oy = page_now.y - my, ow = page_now.w, oh = page_now.h;
+    clip_rect_to_clippers(page, &ox, &oy, &ow, &oh);
+    const bool visible_now = rect_intersect(&nx, &ny, &nw, &nh, rb_x0, rb_y0, rb_x1 - rb_x0, rb_y1 - rb_y0);
+    const bool visible_before = rect_intersect(&ox, &oy, &ow, &oh, rb_x0, rb_y0, rb_x1 - rb_x0, rb_y1 - rb_y0);
+    /* Where moved pixels land: the old visible box, shifted, inside the new one. */
+    int dx = ox + mx, dy = oy + my, dw = ow, dh = oh;
+    if (!visible_now || !visible_before || !rect_intersect(&dx, &dy, &dw, &dh, nx, ny, nw, nh))
+        return false;
+
+    /* Painted over the page by nodes outside the moved subtree: repainted where they are and where the
+     * move carried their pixels. Nodes painted beneath it are hidden by it inside the new box. */
+    ERRect foreign[ER_TRANSLATE_COPY_FOREIGN_MAX];
+    int foreign_count = 0;
+    long foreign_area = 0;
+    for (uint16_t tag = 0U; tag < (uint16_t)ERUI_MAX_NODES; tag++)
+    {
+        ERNode* n = er_get_node(tag);
+        if (!n || n->subtree_hidden || !n->has_last_paint || paints_nothing(n) || node_within(n, t)
+            || node_within(t, n) || !paints_before(t, n))
+            continue;
+        int fx = (int)n->last_paint_rect.x, fy = (int)n->last_paint_rect.y, fw = (int)n->last_paint_rect.w,
+            fh = (int)n->last_paint_rect.h;
+        clip_rect_to_clippers(n, &fx, &fy, &fw, &fh);
+        int bx = fx, by = fy, bw = fw, bh = fh;
+        if (!rect_intersect(&fx, &fy, &fw, &fh, ox, oy, ow, oh) && !rect_intersect(&bx, &by, &bw, &bh, nx, ny, nw, nh))
+            continue;
+        if (foreign_count == ER_TRANSLATE_COPY_FOREIGN_MAX)
+            return false;
+        foreign[foreign_count].x = n->last_paint_rect.x;
+        foreign[foreign_count].y = n->last_paint_rect.y;
+        foreign[foreign_count].w = n->last_paint_rect.w;
+        foreign[foreign_count].h = n->last_paint_rect.h;
+        foreign_count++;
+        foreign_area += 2L * n->last_paint_rect.w * n->last_paint_rect.h;
+        mark_reflow_upward(n);
+    }
+    if (foreign_area * 2L > (long)dw * dh)
+        return false; /* overlays cover too much: the copy would save little */
+
+    /* Committed from here: the subtree's footprints follow its pixels. */
+    for (uint16_t tag = 0U; tag < (uint16_t)ERUI_MAX_NODES; tag++)
+    {
+        ERNode* n = er_get_node(tag);
+        if (!n || !node_within(n, t))
+            continue;
+        if (n->has_last_paint)
+        {
+            n->last_paint_rect.x = (int16_t)(n->last_paint_rect.x + mx);
+            n->last_paint_rect.y = (int16_t)(n->last_paint_rect.y + my);
+        }
+        n->buried_paint_rect.x = (int16_t)(n->buried_paint_rect.x + mx);
+        n->buried_paint_rect.y = (int16_t)(n->buried_paint_rect.y + my);
+    }
+    t->source_dirty = false;
+
+    er_blit_move(dx - mx, dy - my, dw, dh, dx, dy);
+    report_repaint_clamped(dx, dy, dw, dh, rb_x0, rb_y0, rb_x1, rb_y1);
+    const ERRect moved = {dx, dy, dw, dh};
+    const ERRect visible_new = {nx, ny, nw, nh};
+    const ERRect visible_old = {ox, oy, ow, oh};
+    damage_difference(dmg, visible_new, moved, rb_x0, rb_y0, rb_x1, rb_y1);       /* uncovered page */
+    damage_difference(dmg, visible_old, visible_new, rb_x0, rb_y0, rb_x1, rb_y1); /* left behind */
+    for (int i = 0; i < foreign_count; i++)
+    {
+        const ERRect* f = &foreign[i];
+        add_damage(dmg, f->x, f->y, f->w, f->h, rb_x0, rb_y0, rb_x1, rb_y1);
+        report_repaint_clamped(f->x, f->y, f->w, f->h, rb_x0, rb_y0, rb_x1, rb_y1);
+        int cx = f->x + mx, cy = f->y + my, cw = f->w, ch = f->h;
+        if (rect_intersect(&cx, &cy, &cw, &ch, dx, dy, dw, dh))
+        {
+            add_damage(dmg, cx, cy, cw, ch, rb_x0, rb_y0, rb_x1, rb_y1);
+            report_repaint_clamped(cx, cy, cw, ch, rb_x0, rb_y0, rb_x1, rb_y1);
+        }
+    }
+    for (uint8_t ri = 0U; ri < s_removed_set.count; ri++)
+    {
+        int cx = s_removed_set.r[ri].x + mx, cy = s_removed_set.r[ri].y + my, cw = s_removed_set.r[ri].w,
+            ch = s_removed_set.r[ri].h;
+        if (rect_intersect(&cx, &cy, &cw, &ch, dx, dy, dw, dh))
+        {
+            add_damage(dmg, cx, cy, cw, ch, rb_x0, rb_y0, rb_x1, rb_y1);
+            report_repaint_clamped(cx, cy, cw, ch, rb_x0, rb_y0, rb_x1, rb_y1);
+        }
+    }
+    return true;
+}
+
+/**
+ * @brief Moves, where it can, every page that only an animated translate moved since the last commit.
+ *
+ * With `tracking` false (a full repaint) nothing is moved; the flags are consumed either way. A page
+ * inside another one that moves is left to the outer one.
+ */
+static void resolve_translate_moves(bool tracking, ERDamageSet* dmg, int rb_x0, int rb_y0, int rb_x1, int rb_y1)
+{
+    if (tracking)
+        for (uint16_t tag = 0U; tag < (uint16_t)ERUI_MAX_NODES; tag++)
+        {
+            ERNode* n = er_get_node(tag);
+            if (!n || !n->translate_moved)
+                continue;
+            bool outer = true;
+            for (const ERNode* a = er_get_node(n->parent_tag); a && outer; a = er_get_node(a->parent_tag))
+                outer = !a->translate_moved;
+            if (outer)
+                translate_by_copy(n, dmg, rb_x0, rb_y0, rb_x1, rb_y1);
+        }
+    for (uint16_t tag = 0U; tag < (uint16_t)ERUI_MAX_NODES; tag++)
+    {
+        ERNode* n = er_get_node(tag);
+        if (n)
+            n->translate_moved = false;
+    }
+}
+
