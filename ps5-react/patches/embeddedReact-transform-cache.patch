+/* Kept transform sources (pixels in transform.c). A 2D capture is reused while its node keeps the same
+ * content_stamp, the image registry the same generation, and the node the same size. The node's own
+ * transform is not in the key, which is the point: every frame of a scale animation would otherwise
+ * re-render the same subtree, once in each parallel slice it straddles.
+ *
+ * The slots are shared by all render workers. Claims and lookups take the serial lock, and a slot looked
+ * up or claimed this commit is never evicted, since another worker may still be reading it. */
+#define ER_XF_CACHE_ENABLED (ERUI_TRANSFORMS_FULL && ERUI_XFORM_CACHE_SLOTS > 0)
+#if ER_XF_CACHE_ENABLED
+typedef struct
+{
+    uint16_t tag;
+    uint32_t serial;
+    uint32_t stamp;
+    uint32_t image_gen;
+    int w;
+    int h;
+    uint32_t used; /* s_commit_seq of the last lookup or claim */
+    bool ready;    /* false while empty, and while a claim is still copying its pixels */
+} XfCacheSlot;
+
+static XfCacheSlot s_xf_cache[ERUI_XFORM_CACHE_SLOTS];
+
+/** @brief Whether the slots can be shared right now: always outside a fork-join, inside one only with the lock. */
+static bool xf_cache_usable(void)
+{
+    return !s_parallel_render || er_render_serial_supported();
+}
+
+static bool xf_cache_key_matches(const XfCacheSlot* slot, const ERNode* n, int w, int h, uint32_t image_gen)
+{
+    return slot->tag == n->tag && slot->serial == n->serial && slot->stamp == n->content_stamp
+           && slot->image_gen == image_gen && slot->w == w && slot->h == h;
+}
+
+/**
+ * @brief The slot holding @p n's current w×h source, or -1.
+ *
+ * @return Slot index, marked used by this commit.
+ */
+static int xf_cache_find(const ERNode* n, int w, int h)
+{
+    if (!xf_cache_usable())
+        return -1;
+    const uint32_t image_gen = er_image_generation();
+    int found = -1;
+    er_render_serial_begin();
+    for (int i = 0; i < ERUI_XFORM_CACHE_SLOTS; i++)
+    {
+        XfCacheSlot* slot = &s_xf_cache[i];
+        if (slot->ready && xf_cache_key_matches(slot, n, w, h, image_gen))
+        {
+            slot->used = s_commit_seq;
+            found = i;
+            break;
+        }
+    }
+    er_render_serial_end();
+    return found;
+}
+
+/**
+ * @brief Keeps the source the calling worker just captured for @p n, once its content repeats.
+ *
+ * Only the second capture of the same content is kept: a subtree whose content changes every frame would
+ * otherwise copy itself out on every frame and evict sources that do repeat. A source is kept only when
+ * it was captured whole: inside the root, where the occlusion cull reads no screen edge, and outside a
+ * banded pass, whose strip pruning can leave rows out of it.
+ */
+static void xf_cache_store(ERNode* n, int px, int py, int w, int h)
+{
+    if (!xf_cache_usable() || er_band_active(NULL, NULL))
+        return;
+    const ERNode* root = er_get_root_node();
+    if (!root || px < root->computed.x || py < root->computed.y || px + w > root->computed.x + root->computed.w
+        || py + h > root->computed.y + root->computed.h)
+        return;
+    const uint32_t image_gen = er_image_generation();
+    int victim = -1;
+    int victim_rank = 0;
+    er_render_serial_begin();
+    const bool repeated = n->xf_capture_stamp == n->content_stamp;
+    n->xf_capture_stamp = n->content_stamp;
+    for (int i = 0; repeated && i < ERUI_XFORM_CACHE_SLOTS; i++)
+    {
+        const XfCacheSlot* slot = &s_xf_cache[i];
+        if (xf_cache_key_matches(slot, n, w, h, image_gen))
+        {
+            victim = -1; /* kept already, or being kept by another slice */
+            break;
+        }
+        if (slot->used == s_commit_seq)
+            continue;
+        int rank = 1; /* least recently used */
+        if (!slot->ready)
+            rank = 3;
+        else
+        {
+            const ERNode* owner = er_get_node(slot->tag);
+            if (!owner || owner->serial != slot->serial || owner->content_stamp != slot->stamp
+                || slot->image_gen != image_gen)
+                rank = 2;
+        }
+        if (rank > victim_rank || (rank == victim_rank && slot->used < s_xf_cache[victim].used))
+        {
+            victim = i;
+            victim_rank = rank;
+        }
+    }
+    if (victim >= 0)
+    {
+        XfCacheSlot* slot = &s_xf_cache[victim];
+        slot->tag = n->tag;
+        slot->serial = n->serial;
+        slot->stamp = n->content_stamp;
+        slot->image_gen = image_gen;
+        slot->w = w;
+        slot->h = h;
+        slot->used = s_commit_seq;
+        slot->ready = false;
+    }
+    er_render_serial_end();
+    if (victim < 0)
+        return;
+    er_transform_cache_store(victim, w, h);
+    er_render_serial_begin();
+    s_xf_cache[victim].ready = true;
+    er_render_serial_end();
+}
+#endif
