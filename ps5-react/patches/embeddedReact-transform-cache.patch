+
+/*
+ * Kept transform sources (ERUI_XFORM_CACHE_SLOTS) must paint exactly what a fresh capture paints.
+ *
+ * A card scales on the native driver while its content changes underneath: a prop change on a child,
+ * then a translate animation on that child. The run is recorded twice, once letting the cache work and
+ * once re-registering an image before every frame, which advances the image generation and so forces a
+ * fresh capture each time. Every frame of the two runs must match.
+ *
+ * A probe then shows the kept source is really used: an image's pixels changed behind the registry's
+ * back stay unseen while the card keeps scaling, and appear once er_image_load() announces them.
+ *
+ * Multi-worker builds run it all across pthread workers with the serial lock installed, so the slices
+ * the card straddles share the slots.
+ */
+
+#include "er_scene.h"
+#include "native_renderer.h"
+#include "renderer_internal.h"
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define FB_W 320
+#define FB_H 240
+#define FRAME_MS 16
+#define FRAMES 34
+#define SCALE_MS 480
+#define NW ERUI_RENDER_WORKERS
+
+#define PROBE_A 0xFF20C040U
+#define PROBE_B 0xFFC02040U
+
+typedef struct
+{
+    uint32_t* fb;
+} TestCtx;
+
+static uint32_t s_probe[16 * 16];
+
+static uint32_t div255(uint32_t v)
+{
+    return (v + 127U) / 255U;
+}
+
+static uint32_t over(uint32_t d, uint32_t sr, uint32_t sg, uint32_t sb, uint32_t sa)
+{
+    const uint32_t inv = 255U - sa;
+    return 0xFF000000U | ((sr + div255(((d >> 16) & 0xFFU) * inv)) << 16)
+           | ((sg + div255(((d >> 8) & 0xFFU) * inv)) << 8) | (sb + div255((d & 0xFFU) * inv));
+}
+
+static void fill_cb(uint32_t argb, int x, int y, int w, int h, void* ctx)
+{
+    TestCtx* t = ctx;
+    const uint32_t a = (argb >> 24) & 0xFFU;
+    for (int row = y; a && row < y + h; row++)
+        for (int col = x; col < x + w; col++)
+            if (row >= 0 && row < FB_H && col >= 0 && col < FB_W)
+            {
+                uint32_t* d = &t->fb[row * FB_W + col];
+                *d = over(*d,
+                          div255(((argb >> 16) & 0xFFU) * a),
+                          div255(((argb >> 8) & 0xFFU) * a),
+                          div255((argb & 0xFFU) * a),
+                          a);
+            }
+}
+
+static void blend_cb(const void* src, int stride, uint8_t alpha, int x, int y, int w, int h, void* ctx)
+{
+    TestCtx* t = ctx;
+    for (int row = 0; row < h; row++)
+    {
+        const uint32_t* s = (const uint32_t*)((const uint8_t*)src + (size_t)row * (size_t)stride);
+        for (int col = 0; col < w; col++)
+        {
+            const int dx = x + col, dy = y + row;
+            const uint32_t sp = s[col];
+            const uint32_t sa = div255(((sp >> 24) & 0xFFU) * alpha);
+            if (dx < 0 || dx >= FB_W || dy < 0 || dy >= FB_H || sa == 0U)
+                continue;
+            uint32_t* d = &t->fb[dy * FB_W + dx];
+            *d = over(*d,
+                      div255(((sp >> 16) & 0xFFU) * alpha),
+                      div255(((sp >> 8) & 0xFFU) * alpha),
+                      div255((sp & 0xFFU) * alpha),
+                      sa);
+        }
+    }
+}
+
+static void copy_cb(const void* src, int stride, int x, int y, int w, int h, void* ctx)
+{
+    blend_cb(src, stride, 255U, x, y, w, h, ctx);
+}
+
+static int fail(const char* msg)
+{
+    fprintf(stderr, "FAIL: %s\n", msg);
+    return EXIT_FAILURE;
+}
+
+static ERProps props_default(void)
+{
+    ERProps p = {0};
+    p.left = p.top = p.right = p.bottom = ER_LAYOUT_AUTO;
+    p.width = p.height = ER_LAYOUT_AUTO;
+    p.min_width = p.max_width = ER_LAYOUT_AUTO;
+    p.min_height = p.max_height = ER_LAYOUT_AUTO;
+    p.padding = p.padding_left = p.padding_top = ER_LAYOUT_AUTO;
+    p.padding_right = p.padding_bottom = ER_LAYOUT_AUTO;
+    p.margin = p.margin_left = p.margin_top = ER_LAYOUT_AUTO;
+    p.margin_right = p.margin_bottom = ER_LAYOUT_AUTO;
+    p.gap = p.row_gap = p.column_gap = ER_LAYOUT_AUTO;
+    p.flex_basis = ER_LAYOUT_AUTO;
+    p.opacity = 255U;
+    return p;
+}
+
+static ERProps box(int left, int top, int w, int h, uint32_t bg)
+{
+    ERProps p = props_default();
+    p.position = ER_POS_ABSOLUTE;
+    p.left = (int16_t)left;
+    p.top = (int16_t)top;
+    p.width = (int16_t)w;
+    p.height = (int16_t)h;
+    p.background_color = bg;
+    return p;
+}
+
+static void fill_probe(uint32_t argb)
+{
+    for (int i = 0; i < 16 * 16; i++)
+        s_probe[i] = argb;
+}
+
+typedef struct
+{
+    ERNode* card;
+    ERNode* inner;
+    ERAnimValueHandle scale;
+} Scene;
+
+/**
+ * @brief A 120x100 card scaled about its centre, holding a child box and a 40x40 image whose centre is the
+ *        card's, so the pixel at (120, 100) shows the image at every scale.
+ */
+static Scene build_scene(TestCtx* t)
+{
+    er_reset();
+    memset(t->fb, 0, sizeof(uint32_t) * FB_W * FB_H);
+    fill_probe(PROBE_A);
+    er_image_load("probe", s_probe, 16, 16);
+
+    ERNode* root = er_node_create(ER_NODE_VIEW);
+    ERProps rp = box(0, 0, FB_W, FB_H, 0xFF101010U);
+    rp.position = ER_POS_RELATIVE;
+    er_node_set_props(root, &rp);
+
+    Scene s;
+    s.card = er_node_create(ER_NODE_VIEW);
+    ERProps cp = box(60, 50, 120, 100, 0xFF2050A0U);
+    cp.border_radius = 12;
+    cp.transform_origin_x = 0.5f;
+    cp.transform_origin_y = 0.5f;
+    er_node_set_props(s.card, &cp);
+
+    s.inner = er_node_create(ER_NODE_VIEW);
+    ERProps ip = box(8, 8, 30, 20, 0xFFE0C020U);
+    er_node_set_props(s.inner, &ip);
+
+    ERNode* img = er_node_create(ER_NODE_IMAGE);
+    ERProps gp = box(40, 30, 40, 40, 0);
+    strncpy(gp.image_name, "probe", ER_IMAGE_NAME_MAX);
+    gp.resize_mode = ER_RESIZE_STRETCH;
+    er_node_set_props(img, &gp);
+
+    er_tree_append_child(s.card, s.inner);
+    er_tree_append_child(s.card, img);
+    er_tree_append_child(root, s.card);
+    er_tree_set_root(root);
+    er_force_full_repaint();
+    er_commit();
+
+    ERAnimConfig cfg = {0};
+    cfg.type = ER_ANIM_TIMING;
+    cfg.duration_ms = SCALE_MS;
+    cfg.easing = ER_EASE_LINEAR;
+    s.scale = er_anim_value_create(1.0f);
+    er_anim_value_bind(s.scale, s.card, ER_PROP_SCALE_X);
+    er_anim_value_bind(s.scale, s.card, ER_PROP_SCALE_Y);
+    er_anim_value_animate(s.scale, 1.25f, &cfg);
+    return s;
+}
+
+/**
+ * @brief Records the scale run into @p frames; @p fresh re-registers the image before every frame.
+ */
+static void record(TestCtx* t, bool fresh, uint32_t (*frames)[FB_W * FB_H])
+{
+    Scene s = build_scene(t);
+    ERAnimValueHandle slide = er_anim_value_create(0.0f);
+    for (int f = 0; f < FRAMES; f++)
+    {
+        if (f == 10)
+        {
+            ERProps ip = box(8, 8, 30, 20, 0xFF30D0D0U);
+            er_node_set_props(s.inner, &ip);
+        }
+        if (f == 16)
+        {
+            ERAnimConfig cfg = {0};
+            cfg.type = ER_ANIM_TIMING;
+            cfg.duration_ms = 160;
+            cfg.easing = ER_EASE_LINEAR;
+            er_anim_value_bind(slide, s.inner, ER_PROP_TRANSLATE_X);
+            er_anim_value_animate(slide, 24.0f, &cfg);
+        }
+        if (fresh)
+            er_image_load("probe", s_probe, 16, 16);
+        embedded_renderer_tick(FRAME_MS);
+        er_commit();
+        memcpy(frames[f], t->fb, sizeof(frames[f]));
+    }
+}
+
+static int run_equivalence(TestCtx* t)
+{
+    static uint32_t kept[FRAMES][FB_W * FB_H];
+    static uint32_t fresh[FRAMES][FB_W * FB_H];
+    record(t, false, kept);
+    record(t, true, fresh);
+    if (memcmp(kept[2], kept[FRAMES - 1], sizeof(kept[0])) == 0)
+        return fail("the scale animation did not change the frame");
+    for (int f = 0; f < FRAMES; f++)
+    {
+        if (memcmp(kept[f], fresh[f], sizeof(kept[f])) != 0)
+        {
+            char msg[128];
+            snprintf(msg, sizeof(msg), "frame %d differs between kept and fresh transform sources", f);
+            return fail(msg);
+        }
+    }
+    return EXIT_SUCCESS;
+}
+
+static int run_probe(TestCtx* t)
+{
+    build_scene(t);
+    for (int f = 0; f < 4; f++)
+    {
+        embedded_renderer_tick(FRAME_MS);
+        er_commit();
+    }
+    const uint32_t* centre = &t->fb[100 * FB_W + 120];
+    if (*centre != PROBE_A)
+        return fail("the probe image is not at the card's centre");
+
+    fill_probe(PROBE_B); /* behind the registry's back: the kept source still holds A */
+    embedded_renderer_tick(FRAME_MS);
+    er_commit();
+#if ERUI_XFORM_CACHE_SLOTS > 0
+    if (*centre != PROBE_A)
+        return fail("a scale-only frame re-captured the card instead of reusing its kept source");
+#endif
+    er_image_load("probe", s_probe, 16, 16);
+    embedded_renderer_tick(FRAME_MS);
+    er_commit();
+    if (*centre != PROBE_B)
+        return fail("a re-registered image did not invalidate the kept source");
+    return EXIT_SUCCESS;
+}
+
+#if NW > 1
+typedef struct
+{
+    pthread_t thread;
+    pthread_mutex_t mtx;
+    pthread_cond_t cond;
+    int go;
+} Worker;
+
+static Worker s_workers[NW];
+static pthread_mutex_t s_done_mtx = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t s_done_cond = PTHREAD_COND_INITIALIZER;
+static pthread_mutex_t s_serial_mtx = PTHREAD_MUTEX_INITIALIZER;
+static int s_done = 0;
+static int s_dispatched = 0;
+
+static void* worker_main(void* arg)
+{
+    Worker* w = arg;
+    for (;;)
+    {
+        pthread_mutex_lock(&w->mtx);
+        while (!w->go)
+            pthread_cond_wait(&w->cond, &w->mtx);
+        w->go = 0;
+        pthread_mutex_unlock(&w->mtx);
+        er_render_worker_exec((int)(w - s_workers));
+        pthread_mutex_lock(&s_done_mtx);
+        s_done++;
+        pthread_cond_signal(&s_done_cond);
+        pthread_mutex_unlock(&s_done_mtx);
+    }
+    return NULL;
+}
+
+static void host_dispatch(int worker, void* ctx)
+{
+    (void)ctx;
+    Worker* w = &s_workers[worker];
+    pthread_mutex_lock(&w->mtx);
+    w->go = 1;
+    s_dispatched++;
+    pthread_cond_signal(&w->cond);
+    pthread_mutex_unlock(&w->mtx);
+}
+
+static void host_sync(void* ctx)
+{
+    (void)ctx;
+    pthread_mutex_lock(&s_done_mtx);
+    while (s_done < s_dispatched)
+        pthread_cond_wait(&s_done_cond, &s_done_mtx);
+    s_done = s_dispatched = 0;
+    pthread_mutex_unlock(&s_done_mtx);
+}
+
+static int host_worker_id(void)
+{
+    for (int k = 1; k < NW; k++)
+        if (pthread_equal(pthread_self(), s_workers[k].thread))
+            return k;
+    return 0;
+}
+
+static void host_lock(void* ctx)
+{
+    (void)ctx;
+    pthread_mutex_lock(&s_serial_mtx);
+}
+
+static void host_unlock(void* ctx)
+{
+    (void)ctx;
+    pthread_mutex_unlock(&s_serial_mtx);
+}
+
+static void install_workers(void)
+{
+    for (int k = 1; k < NW; k++)
+    {
+        pthread_mutex_init(&s_workers[k].mtx, NULL);
+        pthread_cond_init(&s_workers[k].cond, NULL);
+        pthread_create(&s_workers[k].thread, NULL, worker_main, &s_workers[k]);
+    }
+    static const EmbeddedRenderWorkers workers = {
+        NW, host_dispatch, host_sync, host_worker_id, NULL, host_lock, host_unlock};
+    embedded_renderer_set_workers(&workers);
+}
+#endif
+
+int main(void)
+{
+    static uint32_t fb[FB_W * FB_H];
+    TestCtx tc = {fb};
+    EmbeddedRenderBackend be = {fill_cb, copy_cb, blend_cb, NULL, NULL, &tc};
+    embedded_renderer_set_backend(&be);
+#if NW > 1
+    install_workers();
+#endif
+    if (run_equivalence(&tc) != EXIT_SUCCESS || run_probe(&tc) != EXIT_SUCCESS)
+        return EXIT_FAILURE;
+#if NW > 1
+    if (er_parallel_frames() == 0)
+        return fail("no frame rendered across the workers, so the shared slots went untested");
+#endif
+    printf("PASS: kept transform sources match fresh captures (%d workers, %d slots)\n", NW, ERUI_XFORM_CACHE_SLOTS);
+    return EXIT_SUCCESS;
+}
