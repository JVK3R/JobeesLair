+#ifndef ER_SLICE_MIN_PIXELS
+/* Each slice walks the whole tree and wakes a thread, so a small rect forks across fewer workers. */
+#define ER_SLICE_MIN_PIXELS (128 * 1024)
+#endif
+
+/**
+ * @brief Slices for a sliced render of a w x h region on nworkers: at least 16 rows and
+ *        ER_SLICE_MIN_PIXELS each, at most nworkers. Below 2 the region renders serially.
+ */
+static int slice_count(int w, int h, int nworkers)
+{
+    int n = h / 16;
+    const long by_area = (long)w * h / ER_SLICE_MIN_PIXELS;
+    if (by_area < n)
+        n = (int)by_area;
+    return n < nworkers ? n : nworkers;
+}
 
 /**
  * @brief er_parallel_for job: renders slice `worker` of the repaint region.
@@ -5264,6 +5282,86 @@
     er_push_clip_rect(j->x0, sy0, j->x1 - j->x0, sy1 - sy0);
     render_tree(j->root, j->full_recomposite, false, 0, j->kbd_y);
     er_pop_clip_rect();
+}
+
+/**
+ * @brief A damage-clipped render forked once for all its rects: worker k renders each rect's rows in
+ *        [cut[k], cut[k + 1]), the cuts balancing the damaged area between the bands.
+ */
+typedef struct
+{
+    ERNode* root;
+    bool full_recomposite;
+    const ERDamageSet* dmg;
+    int cut[ERUI_RENDER_WORKERS + 1];
+    int kbd_y;
+} ParallelDamageJob;
+
+static void render_damage_job(int worker, void* arg)
+{
+    const ParallelDamageJob* j = (const ParallelDamageJob*)arg;
+    const int b0 = j->cut[worker], b1 = j->cut[worker + 1];
+    for (uint8_t ri = 0U; ri < j->dmg->count; ri++)
+    {
+        const ERRect* R = &j->dmg->r[ri];
+        const int y0 = R->y > b0 ? R->y : b0;
+        const int y1 = R->y + R->h < b1 ? R->y + R->h : b1;
+        if (y0 >= y1)
+            continue;
+        er_push_clip_rect(R->x, y0, R->w, y1 - y0);
+        render_tree(j->root, j->full_recomposite, false, 0, j->kbd_y);
+        er_pop_clip_rect();
+    }
+}
+
+/** @brief Damaged pixels of @p dmg above row @p y. */
+static long damage_area_above(const ERDamageSet* dmg, int y)
+{
+    long area = 0;
+    for (uint8_t ri = 0U; ri < dmg->count; ri++)
+    {
+        const ERRect* R = &dmg->r[ri];
+        const int rows = y - R->y;
+        area += (long)R->w * (rows <= 0 ? 0 : rows > R->h ? R->h : rows);
+    }
+    return area;
+}
+
+/**
+ * @brief Splits @p dmg into @p n bands of about equal damaged area, at least 16 rows each where the
+ *        damage allows; returns the number of non-empty bands.
+ */
+static int damage_cuts(const ERDamageSet* dmg, int n, int* cut)
+{
+    int top = dmg->r[0].y, bottom = dmg->r[0].y + dmg->r[0].h;
+    for (uint8_t ri = 1U; ri < dmg->count; ri++)
+    {
+        if (dmg->r[ri].y < top)
+            top = dmg->r[ri].y;
+        if (dmg->r[ri].y + dmg->r[ri].h > bottom)
+            bottom = dmg->r[ri].y + dmg->r[ri].h;
+    }
+    const long total = damage_area_above(dmg, bottom);
+    int bands = 0;
+    cut[0] = top;
+    for (int k = 1; k < n; k++)
+    {
+        const long want = total * k / n;
+        int lo = cut[bands] + 16, hi = bottom - 16;
+        if (lo > hi)
+            break;
+        while (lo < hi)
+        {
+            const int mid = lo + (hi - lo) / 2;
+            if (damage_area_above(dmg, mid) < want)
+                lo = mid + 1;
+            else
+                hi = mid;
+        }
+        cut[++bands] = lo;
+    }
+    cut[++bands] = bottom;
+    return bands;
 }
 
