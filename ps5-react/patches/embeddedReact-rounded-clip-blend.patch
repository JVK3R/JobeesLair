+/**
+ * @brief Collects the rounded clips that apply to the next blit, innermost first.
+ *
+ * @param[in]  ctx  The worker's context.
+ * @param[out] out  Receives up to ER_CLIP_STACK_DEPTH entries.
+ *
+ * @return How many apply; 0 for the common case of no rounded clip, without walking the stack.
+ */
+static int active_masks(const NRCtx* ctx, const ClipEntry** out)
+{
+    if (ctx->rounded_count == 0)
+        return 0;
+    int n = 0;
+    for (int i = ctx->clip_depth - 1; i >= ctx->mask_floor; i--)
+    {
+        const ClipEntry* e = &ctx->clip_stack[i];
+        if (e->reset)
+            break;
+        if (e->rounded)
+            out[n++] = e;
+    }
+    return n;
+}
+
+/** @brief Whether screen row @p y crosses one of the mask's corner arcs. */
+static inline bool mask_row_in_corner(const ClipEntry* m, int y)
+{
+    const int row = y - m->by;
+    const int top = m->r_tl > m->r_tr ? m->r_tl : m->r_tr;
+    const int bot = m->r_bl > m->r_br ? m->r_bl : m->r_br;
+    return row < top || row >= m->bh - bot;
+}
+
+/**
+ * @brief Coverage (0–255) of screen pixel @p x on a row the mask resolved into @p rr, as a rounded fill
+ *        of the same box would paint it: the solid span is full, the fringe walks the corner arc.
+ */
+static uint32_t mask_px_cov(const ClipEntry* m, const ERRRectRow* rr, int x)
+{
+    const int col = x - m->bx;
+    if (col < 0 || col >= m->bw)
+        return 0U;
+    if (col >= rr->x0 && col < rr->x1)
+        return 255U;
+#if ERUI_BORDER_AA
+    float cov;
+    if (col < rr->x0)
+    {
+        const int k = rr->x0 - 1 - col;
+        if (rr->l_r <= 0 || k >= er_rrect_fringe_max(rr->l_r))
+            return 0U;
+        cov = er_rrect_fringe_cov(rr->l_r, rr->l_dx, rr->l_dy, k);
+    }
+    else
+    {
+        const int k = col - rr->x1;
+        if (rr->r_r <= 0 || k >= er_rrect_fringe_max(rr->r_r))
+            return 0U;
+        cov = er_rrect_fringe_cov(rr->r_r, rr->r_dx, rr->r_dy, k);
+    }
+    if (cov <= 0.0f)
+        return 0U;
+    return cov >= 1.0f ? 255U : (uint32_t)(cov * 255.0f + 0.5f);
+#else
+    return 0U;
+#endif
+}
