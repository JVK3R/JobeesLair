+/**
+ * @brief Adds a premultiplied ARGB source, scaled by a global alpha, into the scratch buffer.
+ *
+ * Every channel saturates at 255, alpha included: a capture holds no backdrop, so what was added is kept
+ * as ordinary premultiplied coverage and the group composites normally when it is blended out.
+ *
+ * @param[in] src     Source pixel buffer (premultiplied ARGB8888).
+ * @param[in] stride  Source row stride in bytes.
+ * @param[in] alpha   Global alpha scale.
+ * @param[in] lx      Scratch-local left edge.
+ * @param[in] ly      Scratch-local top edge.
+ * @param[in] lw      Width in pixels.
+ * @param[in] lh      Height in pixels.
+ */
+static void scratch_do_add(const void* src, int stride, uint8_t alpha, int lx, int ly, int lw, int lh)
+{
+    NRCtx* const ctx = rc();
+    if (alpha == 0U)
+        return;
+    const int x0 = lx < 0 ? 0 : lx;
+    const int y0 = ly < 0 ? 0 : ly;
+    const int x1 = (lx + lw) > ctx->scratch_w ? ctx->scratch_w : (lx + lw);
+    const int y1 = (ly + lh) > ctx->scratch_h ? ctx->scratch_h : (ly + lh);
+    if (x0 >= x1 || y0 >= y1)
+        return;
+    src = (const uint8_t*)src + (size_t)(y0 - ly) * (size_t)stride + (size_t)(x0 - lx) * 4U;
+
+    for (int row = y0; row < y1; row++)
+    {
+        const uint32_t* src_row = (const uint32_t*)((const uint8_t*)src + (size_t)(row - y0) * (size_t)stride);
+        uint32_t* dst_row = ctx->scratch_buf + (size_t)row * ctx->scratch_w;
+        for (int col = x0; col < x1; col++)
+        {
+            const uint32_t sp = er_px_scale_premul(src_row[col - x0], alpha);
+            if (sp == 0U)
+                continue;
+            const uint32_t d = dst_row[col];
+            uint32_t out = 0U;
+            for (int sh = 0; sh < 32; sh += 8)
+            {
+                const uint32_t c = ((sp >> sh) & 0xFFU) + ((d >> sh) & 0xFFU);
+                out |= (c > 255U ? 255U : c) << sh;
+            }
+            dst_row[col] = out;
+        }
+    }
+}
