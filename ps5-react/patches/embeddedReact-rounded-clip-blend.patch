+
+/*
+ * roundedClip masks children to the parent's rounded box exactly as a rounded background of that box is
+ * painted, while overflow hidden alone still clips to the rectangle. mixBlendMode plus-lighter adds a
+ * subtree's drawing to what is beneath it, inside opacity groups too. Every damage-clipped frame matches
+ * a full repaint.
+ */
+#include "er_scene.h"
+#include "native_renderer.h"
+#include "renderer_internal.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define FB_W 160
+#define FB_H 120
+#define BG 0xFF404040U
+
+typedef struct
+{
+    uint32_t* fb;
+    int fb_w;
+    int fb_h;
+} TestCtx;
+
+static uint32_t div255(uint32_t v)
+{
+    return (v + 127U) / 255U;
+}
+
+static uint32_t* px_ref(TestCtx* t, int x, int y)
+{
+    return (x < 0 || y < 0 || x >= t->fb_w || y >= t->fb_h) ? NULL : &t->fb[y * t->fb_w + x];
+}
+
+/** @brief Source-over of one premultiplied pixel, alpha channel included. */
+static uint32_t over(uint32_t d, uint32_t s)
+{
+    const uint32_t inv = 255U - (s >> 24);
+    uint32_t out = 0U;
+    for (int sh = 0; sh < 32; sh += 8)
+        out |= (((s >> sh) & 0xFFU) + div255(((d >> sh) & 0xFFU) * inv)) << sh;
+    return out;
+}
+
+static uint32_t scale(uint32_t p, uint32_t a)
+{
+    uint32_t out = 0U;
+    for (int sh = 0; sh < 32; sh += 8)
+        out |= div255(((p >> sh) & 0xFFU) * a) << sh;
+    return out;
+}
+
+static void fill_cb(uint32_t argb, int x, int y, int w, int h, void* ctx)
+{
+    const uint32_t a = argb >> 24;
+    const uint32_t s = (a << 24) | (div255(((argb >> 16) & 0xFFU) * a) << 16) | (div255(((argb >> 8) & 0xFFU) * a) << 8)
+                       | div255((argb & 0xFFU) * a);
+    for (int row = y; row < y + h; row++)
+        for (int col = x; col < x + w; col++)
+        {
+            uint32_t* d = px_ref(ctx, col, row);
+            if (d)
+                *d = over(*d, s);
+        }
+}
+
+static void blend_cb(const void* src, int stride, uint8_t alpha, int x, int y, int w, int h, void* ctx)
+{
+    for (int row = 0; row < h; row++)
+    {
+        const uint32_t* s = (const uint32_t*)((const uint8_t*)src + (size_t)row * (size_t)stride);
+        for (int col = 0; col < w; col++)
+        {
+            uint32_t* d = px_ref(ctx, x + col, y + row);
+            if (d)
+                *d = over(*d, scale(s[col], alpha));
+        }
+    }
+}
+
+static void copy_cb(const void* src, int stride, int x, int y, int w, int h, void* ctx)
+{
+    blend_cb(src, stride, 255U, x, y, w, h, ctx);
+}
+
+/** @brief Adds colour, saturating, and keeps the destination alpha (the backend contract). */
+static void add_cb(const void* src, int stride, uint8_t alpha, int x, int y, int w, int h, void* ctx)
+{
+    for (int row = 0; row < h; row++)
+    {
+        const uint32_t* s = (const uint32_t*)((const uint8_t*)src + (size_t)row * (size_t)stride);
+        for (int col = 0; col < w; col++)
+        {
+            uint32_t* d = px_ref(ctx, x + col, y + row);
+            if (!d)
+                continue;
+            const uint32_t sp = scale(s[col], alpha);
+            uint32_t out = *d & 0xFF000000U;
+            for (int sh = 0; sh < 24; sh += 8)
+            {
+                const uint32_t c = ((sp >> sh) & 0xFFU) + ((*d >> sh) & 0xFFU);
+                out |= (c > 255U ? 255U : c) << sh;
+            }
+            *d = out;
+        }
+    }
+}
+
+static int fail(const char* msg)
+{
+    fprintf(stderr, "FAIL: %s\n", msg);
+    return EXIT_FAILURE;
+}
+
+static ERProps props_default(void)
+{
+    ERProps p = {0};
+    p.left = p.top = p.right = p.bottom = ER_LAYOUT_AUTO;
+    p.width = p.height = ER_LAYOUT_AUTO;
+    p.min_width = p.max_width = ER_LAYOUT_AUTO;
+    p.min_height = p.max_height = ER_LAYOUT_AUTO;
+    p.padding = p.padding_left = p.padding_top = ER_LAYOUT_AUTO;
+    p.padding_right = p.padding_bottom = ER_LAYOUT_AUTO;
+    p.margin = p.margin_left = p.margin_top = ER_LAYOUT_AUTO;
+    p.margin_right = p.margin_bottom = ER_LAYOUT_AUTO;
+    p.gap = p.row_gap = p.column_gap = ER_LAYOUT_AUTO;
+    p.flex_basis = ER_LAYOUT_AUTO;
+    p.opacity = 255U;
+    return p;
+}
+
+static ERProps box(int x, int y, int w, int h, uint32_t bg)
+{
+    ERProps p = props_default();
+    p.position = ER_POS_ABSOLUTE;
+    p.left = (int16_t)x;
+    p.top = (int16_t)y;
+    p.width = (int16_t)w;
+    p.height = (int16_t)h;
+    p.background_color = bg;
+    return p;
+}
+
+static ERNode* add_node(ERNode* parent, const ERProps* p)
+{
+    ERNode* n = er_node_create(ER_NODE_VIEW);
+    er_node_set_props(n, p);
+    er_tree_append_child(parent, n);
+    return n;
+}
+
+static ERNode* scene_root(void)
+{
+    er_reset();
+    ERNode* root = er_node_create(ER_NODE_VIEW);
+    ERProps rp = box(0, 0, FB_W, FB_H, BG);
+    rp.position = ER_POS_RELATIVE;
+    rp.left = rp.top = ER_LAYOUT_AUTO;
+    er_node_set_props(root, &rp);
+    er_tree_set_root(root);
+    return root;
+}
+
+static void render_full(uint32_t* fb)
+{
+    memset(fb, 0, sizeof(uint32_t) * FB_W * FB_H);
+    er_force_full_repaint();
+    er_commit();
+}
+
+/** @brief The committed frame must equal a full repaint of the same scene. */
+static bool matches_full_repaint(uint32_t* fb)
+{
+    static uint32_t incremental[FB_W * FB_H];
+    memcpy(incremental, fb, sizeof(incremental));
+    render_full(fb);
+    return memcmp(incremental, fb, sizeof(incremental)) == 0;
+}
+
+static bool near(uint32_t a, uint32_t b)
+{
+    for (int sh = 0; sh < 32; sh += 8)
+    {
+        const int d = (int)((a >> sh) & 0xFFU) - (int)((b >> sh) & 0xFFU);
+        if (d < -1 || d > 1)
+            return false;
+    }
+    return true;
+}
+
+int main(void)
+{
+    static uint32_t fb[FB_W * FB_H];
+    static uint32_t reference[FB_W * FB_H];
+    TestCtx t = {fb, FB_W, FB_H};
+    EmbeddedRenderBackend be = {0};
+    be.fill_rect = fill_cb;
+    be.copy_rect = copy_cb;
+    be.blend_rect = blend_cb;
+    be.add_rect = add_cb;
+    be.ctx = &t;
+    embedded_renderer_set_backend(&be);
+
+    /* The reference: a rounded red background of the card's box. */
+    ERNode* root = scene_root();
+    ERProps card = box(20, 20, 100, 60, 0xFFE03020U);
+    card.border_radius = 14;
+    add_node(root, &card);
+    render_full(fb);
+    memcpy(reference, fb, sizeof(reference));
+
+    /* A rounded clip over a square red child paints exactly that. */
+    root = scene_root();
+    card.background_color = 0;
+    card.rounded_clip = 1;
+    ERNode* clip = add_node(root, &card);
+    const ERProps fill = box(-10, -10, 120, 80, 0xFFE03020U);
+    ERNode* child = add_node(clip, &fill);
+    render_full(fb);
+    if (memcmp(fb, reference, sizeof(reference)) != 0)
+        return fail("a child under roundedClip differs from a rounded fill of the same box");
+
+    /* Overflow hidden alone still clips to the rectangle. */
+    card.rounded_clip = 0;
+    card.overflow = ER_OVERFLOW_HIDDEN;
+    er_node_set_props(clip, &card);
+    er_commit();
+    if (t.fb[20 * FB_W + 20] != 0xFFE03020U)
+        return fail("overflow hidden without roundedClip rounded the corners");
+    if (!matches_full_repaint(fb))
+        return fail("turning roundedClip off left a frame that differs from a full repaint");
+
+    /* Back on: the corners return to the background, repainted by damage alone. */
+    card.rounded_clip = 1;
+    er_node_set_props(clip, &card);
+    er_commit();
+    if (t.fb[20 * FB_W + 20] != BG || memcmp(fb, reference, sizeof(reference)) != 0)
+        return fail("turning roundedClip on did not repaint the corners");
+
+    /* A translucent child is captured offscreen and blended out through the mask: masked once, not twice. */
+    ERProps faded = fill;
+    faded.opacity = 160U;
+    er_node_set_props(child, &faded);
+    er_commit();
+    if (t.fb[20 * FB_W + 20] != BG || t.fb[50 * FB_W + 70] == BG || t.fb[50 * FB_W + 70] == 0xFFE03020U)
+        return fail("a translucent child under roundedClip is not blended inside the corners");
+    for (int i = 0; i < FB_W * FB_H; i++)
+    {
+        /* Same coverage as the rounded fill: wherever the reference is partly red, so is this, by as much. */
+        const uint32_t r = (reference[i] >> 16) & 0xFFU, f = (t.fb[i] >> 16) & 0xFFU;
+        const uint32_t want = 0x40U + div255((r - 0x40U) * 160U);
+        if (r >= 0x40U && (f + 1U < want || f > want + 1U))
+            return fail("a translucent child's corner coverage differs from the rounded fill's");
+    }
+    if (!matches_full_repaint(fb))
+        return fail("the masked translucent child differs from a full repaint");
+
+#if ERUI_GRADIENT
+    /* A translucent gradient child goes through the blend path and is masked the same way. */
+    ERProps grad = fill;
+    grad.background_color = 0;
+    grad.gradient_type = ER_GRADIENT_LINEAR;
+    grad.gradient_angle = 90.0f;
+    grad.gradient_stop_count = 2;
+    grad.gradient_stops[0] = (ERGradientStop){0xC0FFFFFFU, 0.0f};
+    grad.gradient_stops[1] = (ERGradientStop){0xC000A0FFU, 1.0f};
+    er_node_set_props(child, &grad);
+    er_commit();
+    if (t.fb[20 * FB_W + 20] != BG || t.fb[(20 + 59) * FB_W + 20 + 99] != BG)
+        return fail("a gradient child painted past the rounded corners");
+    if (t.fb[50 * FB_W + 70] == BG)
+        return fail("a gradient child under roundedClip painted nothing inside");
+    if (!matches_full_repaint(fb))
+        return fail("the masked gradient differs from a full repaint");
+#endif
+
+    /* Moving the child repaints by damage to the same pixels as a full repaint. */
+    faded.left = -4;
+    faded.top = -2;
+    er_node_set_props(child, &faded);
+    er_commit();
+    if (!matches_full_repaint(fb))
+        return fail("moving a child under roundedClip differs from a full repaint");
+
+    /* Nested rounded clips multiply: a tighter inner clip rounds its own corners inside the outer. */
+    ERProps inner = box(0, 0, 50, 30, 0);
+    inner.border_radius = 10;
+    inner.rounded_clip = 1;
+    er_node_set_props(child, &fill);
+    ERNode* inner_clip = add_node(child, &inner);
+    const ERProps white = box(0, 0, 200, 200, 0xFFFFFFFFU);
+    add_node(inner_clip, &white);
+    er_commit();
+    /* child sits at (-10, -10) in the card, so the inner box starts at the card's top-left minus 10. */
+    if (t.fb[20 * FB_W + 20] != BG)
+        return fail("a nested rounded clip painted past the outer corner");
+    if (t.fb[(10 + 29) * FB_W + 10 + 25] != 0xFFFFFFFFU)
+        return fail("the nested clip's content is missing");
+    if (!matches_full_repaint(fb))
+        return fail("nested rounded clips differ from a full repaint");
+
+    /* plus-lighter adds to what is beneath, overlapping children add up, and it saturates. */
+    root = scene_root();
+    ERProps a = box(10, 10, 40, 40, 0xFF302010U);
+    a.blend_mode = ER_BLEND_ADD;
+    add_node(root, &a);
+    ERProps b = box(30, 30, 40, 40, 0xFF302010U);
+    b.blend_mode = ER_BLEND_ADD;
+    add_node(root, &b);
+    ERProps hot = box(100, 10, 20, 20, 0xFFF0F0F0U);
+    hot.blend_mode = ER_BLEND_ADD;
+    add_node(root, &hot);
+    ERProps half = box(100, 60, 20, 20, 0x80FFFFFFU);
+    half.blend_mode = ER_BLEND_ADD;
+    add_node(root, &half);
+    render_full(fb);
+    if (t.fb[15 * FB_W + 15] != 0xFF706050U)
+        return fail("plus-lighter did not add its colour to the background");
+    if (t.fb[40 * FB_W + 40] != 0xFFA08060U)
+        return fail("overlapping plus-lighter views did not add up");
+    if (t.fb[20 * FB_W + 110] != 0xFFFFFFFFU)
+        return fail("plus-lighter did not saturate at white");
+    if (t.fb[70 * FB_W + 110] != 0xFFC0C0C0U)
+        return fail("a translucent plus-lighter fill did not add its premultiplied colour");
+
+    /* A plus-lighter group at half opacity adds its normal-blended subtree at half strength. */
+    root = scene_root();
+    ERProps group = box(10, 10, 60, 60, 0);
+    group.blend_mode = ER_BLEND_ADD;
+    group.opacity = 128U;
+    ERNode* g = add_node(root, &group);
+    const ERProps gray = box(0, 0, 60, 60, 0xFF404040U);
+    add_node(g, &gray);
+    render_full(fb);
+    if (!near(t.fb[40 * FB_W + 40], 0xFF606060U))
+        return fail("a half-opacity plus-lighter group did not add at half strength");
+
+#if ERUI_GRADIENT
+    /* The glass: an additive gradient band inside a rounded clip lights the card and nothing past it. */
+    root = scene_root();
+    ERNode* glass = add_node(root, &card);
+    ERProps base = box(0, 0, 100, 60, 0xFF203040U);
+    add_node(glass, &base);
+    ERProps band = box(-30, 0, 160, 60, 0);
+    band.blend_mode = ER_BLEND_ADD;
+    band.gradient_type = ER_GRADIENT_LINEAR;
+    band.gradient_angle = 90.0f;
+    band.gradient_stop_count = 3;
+    band.gradient_stops[0] = (ERGradientStop){0x00FFFFFFU, 0.0f};
+    band.gradient_stops[1] = (ERGradientStop){0x80FFFFFFU, 0.5f};
+    band.gradient_stops[2] = (ERGradientStop){0x00FFFFFFU, 1.0f};
+    ERNode* light = add_node(glass, &band);
+    render_full(fb);
+    if (t.fb[20 * FB_W + 20] != BG)
+        return fail("the additive band lit past the rounded corner");
+    if ((t.fb[50 * FB_W + 70] & 0xFFU) <= 0x40U)
+        return fail("the additive band did not brighten the card");
+    band.left = -10;
+    er_node_set_props(light, &band);
+    er_commit();
+    if (!matches_full_repaint(fb))
+        return fail("moving the additive band differs from a full repaint");
+#endif
+
+    /* Without add_rect the backend draws plus-lighter source-over: dimmer, never missing. */
+    be.add_rect = NULL;
+    embedded_renderer_set_backend(&be);
+    root = scene_root();
+    add_node(root, &a);
+    render_full(fb);
+    if (t.fb[15 * FB_W + 15] != 0xFF302010U)
+        return fail("without add_rect plus-lighter did not fall back to source-over");
+
+    return EXIT_SUCCESS;
+}
