+/**
+ * @brief Sets resolved_rtl on a node and everything under it: its own direction, else its parent's.
+ *
+ * Logical edges (start/end) read it. One walk per layout pass, and none until some node sets a logical edge.
+ *
+ * @param[in] tag         Node.
+ * @param[in] parent_rtl  The direction it inherits.
+ */
+static void resolve_directions(const uint16_t tag, const bool parent_rtl)
+{
+    ERNode* n = er_get_node(tag);
+    if (!n)
+        return;
+    const bool rtl = n->layout.direction == ER_DIRECTION_INHERIT ? parent_rtl : n->layout.direction == ER_DIRECTION_RTL;
+    n->layout.resolved_rtl = rtl;
+    for (uint16_t ct = n->first_child_tag; ct != ER_INVALID_TAG;)
+    {
+        const ERNode* c = er_get_node(ct);
+        if (!c)
+            break;
+        resolve_directions(ct, rtl);
+        ct = c->next_sibling_tag;
+    }
+}
+
