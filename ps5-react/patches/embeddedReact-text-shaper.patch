+
     const bool base_bold = (base_font_weight != 0U);
     long width = 0;
     for (uint8_t si = 0; si < span_count; si++)
@@ -891,6 +932,10 @@ int er_text_wrap(const char* text,
     if (!src || !src[0])
         return 1;
 
+    if (s_shaper && s_shaper->claims(src, font_family, er_text_clamp_font_size(font_size)))
