Embedded React: hand text the bitmap fonts cannot draw to a host shaper.

Modified from Embedded React (Apache-2.0, Copyright 2026 Cory Lamming) at the
revision pinned in dependencies.lock.json, after the patches listed before this
one there. Changed files: engine/text/text_renderer.c, engine/scene/compositor.c,
and the new engine/text/er_text_shaper.h. Not yet proposed upstream.

Baked bitmap fonts draw one glyph per codepoint, left to right, from the
characters chosen at build time. That cannot cover CJK (tens of thousands of
characters) nor scripts that need shaping. er_text_set_shaper() installs an
ERTextShaper: er_text_render, er_text_measure, er_text_measure_spans and
er_text_wrap ask its claims() first and hand the text over when it returns
true, so layout and drawing agree. The shaper draws through the new
er_text_draw_glyph (a baked glyph), er_text_draw_coverage (an 8-bit coverage
bitmap) and er_text_fill. Without a shaper nothing changes.

Text and TextInput strings copied into a node at ER_TEXT_MAX bytes no longer
keep a UTF-8 sequence cut in half at the end.

diff --git a/engine/scene/compositor.c b/engine/scene/compositor.c
index c04c6e2..93fa426 100644
--- a/engine/scene/compositor.c
+++ b/engine/scene/compositor.c
@@ -62,6 +62,21 @@ static inline bool cursor_blink_on(uint64_t now_ms)
     return ((uint32_t)now_ms % ER_CURSOR_BLINK_MS) < (ER_CURSOR_BLINK_MS / 2U);
 }
 
+/** @brief Drops a UTF-8 sequence cut short at the end of @p s, as a copy truncated to a byte limit leaves. */
+static void trim_partial_utf8(char* s)
+{
+    const size_t n = strlen(s);
+    size_t lead = n;
+    while (lead > 0 && ((uint8_t)s[lead - 1] & 0xC0U) == 0x80U)
+        lead--;
+    if (lead == 0 || (uint8_t)s[lead - 1] < 0xC0U)
+        return;
+    const uint8_t b = (uint8_t)s[lead - 1];
+    const size_t need = (b >= 0xF0U) ? 4U : (b >= 0xE0U) ? 3U : 2U;
+    if (n - (lead - 1) < need)
+        s[lead - 1] = '\0';
+}
+
 /*----------------------------------------------------------------------------------------------------------------------
  - Variables: Private
  ---------------------------------------------------------------------------------------------------------------------*/
@@ -3525,6 +3540,7 @@ void er_node_set_props(ERNode* node, const ERProps* props)
         case ER_NODE_TEXT:
             strncpy(node->props.text.text, props->text, ER_TEXT_MAX);
             node->props.text.text[ER_TEXT_MAX] = '\0';
+            trim_partial_utf8(node->props.text.text);
             strncpy(node->props.text.font_family, props->font_family, ER_FONT_FAMILY_MAX);
             node->props.text.font_family[ER_FONT_FAMILY_MAX] = '\0';
             node->props.text.color = props->color;
@@ -3869,6 +3885,7 @@ void er_text_input_set_text(ERNode* node, const char* text)
         return;
     strncpy(node->input_text, text, ER_TEXT_MAX);
     node->input_text[ER_TEXT_MAX] = '\0';
+    trim_partial_utf8(node->input_text);
     er_mark_dirty_upward(node);
 }
 
