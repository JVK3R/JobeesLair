@@ -905,3 +950,44 @@ uint32_t er_text_measure_count(void)
 {
     return s_text_measure_count;
 }
+
+void er_text_set_shaper(const ERTextShaper* shaper)
+{
+    s_shaper = shaper;
+}
+
+const BitmapFont* er_text_font(const char* font_family, uint8_t font_size)
+{
+    return font_registry_get(font_family, er_text_clamp_font_size(font_size));
+}
+
+void er_text_draw_glyph(const BitmapFont* font,
+                        uint32_t codepoint,
+                        int x,
+                        int line_top,
+                        const ERRect* clip,
+                        uint32_t color,
+                        bool italic)
+{
+    draw_cp(font, codepoint, x, line_top, clip, color, italic);
+}
+
+void er_text_draw_coverage(const uint8_t* coverage,
+                           int width,
+                           int height,
+                           int x,
+                           int y,
+                           const ERRect* clip,
+                           uint32_t color,
+                           bool italic)
+{
+    if (width <= 0 || height <= 0 || width > 255 || height > 255)
+        return;
+    const GlyphInfo g = {.bitmap_offset = 0U, .width = (uint8_t)width, .height = (uint8_t)height};
+    draw_glyph_aa(&g, coverage, ERUI_FONT_FMT_8BIT, x, y, clip, color, italic);
+}
+
+void er_text_fill(uint32_t color, int x, int y, int width, int height)
+{
+    er_blit_fill(color, x, y, width, height);
+}
