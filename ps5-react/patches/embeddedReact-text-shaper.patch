+#ifndef EMBEDDED_REACT_TEXT_SHAPER_H
+#define EMBEDDED_REACT_TEXT_SHAPER_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+/* Both are C headers without their own linkage guard; a C++ shaper calls font_glyph(). */
+#include "font_bitmap.h"
+#include "text_renderer.h"
+
+    /**
+     * @brief A host-provided text layout engine for text the baked bitmap fonts cannot draw alone.
+     *
+     * The bitmap path draws one baked glyph per codepoint, left to right. Scripts that need shaping,
+     * glyphs that were never baked (a CJK font has tens of thousands) and right-to-left text go to a
+     * shaper when one is installed: er_text_render, er_text_measure, er_text_measure_spans and
+     * er_text_wrap ask claims() first and hand the text over when it returns true, so layout and
+     * drawing always agree. All callbacks run on the render thread.
+     */
+    typedef struct ERTextShaper
+    {
+        /** True when the shaper lays out @p text (UTF-8, spans already merged). Must be cheap. */
+        bool (*claims)(const char* text, const char* font_family, uint8_t font_size);
+        /** Single-line width and line height, as er_text_measure() reports them. */
+        void (*measure)(const char* text,
+                        uint8_t font_size,
+                        const char* font_family,
+                        int16_t letter_spacing,
+                        uint8_t font_weight,
+                        int* out_width,
+                        int* out_height);
+        /** Line count and widest line at @p max_w, as er_text_wrap() reports them. */
+        int (*wrap)(const char* text,
+                    uint8_t font_size,
+                    const char* font_family,
+                    int16_t letter_spacing,
+                    uint8_t font_weight,
+                    int max_w,
+                    int max_lines,
+                    int* out_width);
+        /** Draws @p text with @p params; @p span_map gives each byte's span index, or is NULL. */
+        void (*render)(const ERTextRenderParams* params, const char* text, const uint8_t* span_map);
+    } ERTextShaper;
+
+    /** @brief Installs (or, with NULL, removes) the shaper. The struct must outlive its use. */
+    void er_text_set_shaper(const ERTextShaper* shaper);
+
+    /** @brief The baked font text of this family and size is drawn with (clamped as the renderer does). */
+    const BitmapFont* er_text_font(const char* font_family, uint8_t font_size);
+
+    /** @brief Draws one baked glyph with its cursor at @p x and its line box top at @p line_top. */
+    void er_text_draw_glyph(const BitmapFont* font,
+                            uint32_t codepoint,
+                            int x,
+                            int line_top,
+                            const ERRect* clip,
+                            uint32_t color,
+                            bool italic);
+
+    /**
+     * @brief Blends an 8-bit coverage bitmap (@p width ≤ 255 bytes per row) with its top-left at (@p x, @p y).
+     */
+    void er_text_draw_coverage(const uint8_t* coverage,
+                               int width,
+                               int height,
+                               int x,
+                               int y,
+                               const ERRect* clip,
+                               uint32_t color,
+                               bool italic);
+
+    /** @brief Fills a rectangle (an underline or strike-through); the caller clips it. */
+    void er_text_fill(uint32_t color, int x, int y, int width, int height);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
