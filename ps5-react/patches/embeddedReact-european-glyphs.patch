+    expect(has('cyrillic', 'ЁёАаЯяЩщЪъЇїЄєІіЎўЂђЉљҐґ№')).toBe(true);
+    expect(has('european', 'ñÇŁЖжΏώςΪ€')).toBe(true);
+  });
