+/**
+ * @brief Narrows destination [0, w) x [0, h) at (x, y) to the part inside the active clip.
+ *
+ * Every blit is clipped to it anyway; sampling only this part keeps a repaint that touches a corner
+ * of a large image from converting or re-scaling all of it.
+ *
+ * @return false when nothing of the destination is visible.
+ */
+static bool visible_part(int x, int y, int w, int h, int* x0, int* y0, int* x1, int* y1)
+{
+    *x0 = 0;
+    *y0 = 0;
+    *x1 = w;
+    *y1 = h;
+    int cx, cy, cw, ch;
+    if (er_get_clip_rect(&cx, &cy, &cw, &ch))
+    {
+        if (cx - x > *x0)
+            *x0 = cx - x;
+        if (cy - y > *y0)
+            *y0 = cy - y;
+        if (cx + cw - x < *x1)
+            *x1 = cx + cw - x;
+        if (cy + ch - y < *y1)
+            *y1 = cy + ch - y;
+    }
+    return *x0 < *x1 && *y0 < *y1;
+}
