+ * @brief Maps destination index d of dst_len onto the source span [start, start + len), with
+ * half-pixel alignment for correct up-sampling, clamped to the span.
+ */
+static Tap bilinear_tap(int start, int len, int dst_len, int d)
+{
+    float s = (float)start + ((float)d + 0.5f) * (float)len / (float)dst_len - 0.5f;
+    const float last = (float)(start + len - 1);
+    if (s < (float)start)
+        s = (float)start;
+    if (s > last)
+        s = last;
+    Tap t;
+    t.i0 = (int)s;
+    t.i1 = t.i0 + 1 < start + len ? t.i0 + 1 : t.i0;
+    t.f = (uint32_t)((s - (float)t.i0) * 256.0f + 0.5f);
+    return t;
