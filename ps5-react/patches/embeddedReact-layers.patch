+/** @brief Fills @p c for an image that asks to be a layer; false when it cannot be one at all. */
+static bool layer_candidate(ERNode* n, LayerCandidate* c)
+{
+    const ERImageProps* ip = &n->props.image;
+    if (n->subtree_hidden || n->layout.display == ER_DISPLAY_NONE || ip->tint_color != 0U)
+        return false;
+    if (ip->radius_tl > 0 || ip->radius_tr > 0 || ip->radius_br > 0 || ip->radius_bl > 0)
+        return false;
+    if (ip->resize_mode != ER_RESIZE_COVER && ip->resize_mode != ER_RESIZE_STRETCH)
+        return false;
+    const ImageEntry* img = image_registry_get(ip->image_name);
+    if (!img || !img->opaque || img->format != ER_IMG_ARGB8888 || img->w <= 0 || img->h <= 0)
+        return false;
+    int px, py, w, h;
+    if (!node_screen_rect(n, &px, &py, &w, &h))
+        return false;
+    er_layout_content_box(&n->layout, &px, &py, &w, &h);
+    if (w <= 0 || h <= 0)
+        return false;
+
+    memset(c, 0, sizeof(*c));
+    c->image = n;
+    c->entry = img;
+    uint32_t alpha = 255U;
+    bool chained = true;
+    const ERNode* child = n;
+    for (ERNode* a = er_get_node(n->parent_tag); a; child = a, a = er_get_node(a->parent_tag))
+    {
+#if ERUI_TRANSFORMS_FULL
+        if (er_node_has_complex_transform(a))
+            return false;
+#endif
+        if (a->type == ER_NODE_MODAL || a->subtree_hidden)
+            return false;
+        chained = chained && c->chain_len < LAYER_CHAIN_MAX && layer_chain_link(a, child);
+        if (chained)
+            c->chain[c->chain_len++] = a;
+        const bool view = (a->type == ER_NODE_VIEW || a->type == ER_NODE_SCROLL_VIEW || a->type == ER_NODE_PRESSABLE
+                           || a->type == ER_NODE_FLAT_LIST);
+        if (view && a->props.view.opacity != 255U)
+        {
+            if (!chained)
+                return false; /* the opacity applies to more than this image */
+            alpha = alpha * a->props.view.opacity / 255U;
+        }
+    }
+    c->alpha = (uint8_t)alpha;
+    c->dst = (ERRect){px, py, w, h};
+    int cx = px, cy = py, cw = w, ch = h;
+    clip_rect_to_clippers(n, &cx, &cy, &cw, &ch);
+    c->clip = (ERRect){cx, cy, cw, ch};
+
+    if (ip->resize_mode == ER_RESIZE_COVER)
+    {
+        /* The crop er_image_render() draws. */
+        if (w * img->h >= h * img->w)
+        {
+            c->src_w = img->w;
+            c->src_h = (h * img->w + w / 2) / w;
+        }
+        else
+        {
+            c->src_h = img->h;
+            c->src_w = (w * img->h + h / 2) / h;
+        }
+        if (c->src_w < 1)
+            c->src_w = 1;
+        if (c->src_h < 1)
+            c->src_h = 1;
+        c->src_x = (img->w - c->src_w) / 2;
+        c->src_y = (img->h - c->src_h) / 2;
+    }
+    else
+    {
+        c->src_w = img->w;
+        c->src_h = img->h;
+    }
+    return true;
+}
+
+static ERNode* layer_top(const LayerCandidate* c)
+{
+    return c->chain_len > 0 ? c->chain[c->chain_len - 1] : c->image;
+}
+
+static int node_depth(const ERNode* n)
+{
+    int depth = 0;
+    for (; n; n = er_get_node(n->parent_tag))
+        depth++;
+    return depth;
+}
+
+/** @brief Position of @p child among its parent's children in paint order (z-sorted), or -1. */
+static int paint_index(const ERNode* parent, const ERNode* child)
+{
+    uint16_t tags[ERUI_MAX_NODES];
+    const int count = er_collect_children(parent, tags, ERUI_MAX_NODES);
+    er_sort_children_by_z_index(tags, count);
+    for (int i = 0; i < count; i++)
+        if (tags[i] == child->tag)
+            return i;
+    return -1;
+}
+
+/** @brief Whether @p a is painted before @p b (an ancestor paints before its descendants). */
+static bool paints_before(const ERNode* a, const ERNode* b)
+{
+    int da = node_depth(a), db = node_depth(b);
+    for (; da > db; da--)
+    {
+        a = er_get_node(a->parent_tag);
+        if (a == b)
+            return false;
+    }
+    for (; db > da; db--)
+    {
+        b = er_get_node(b->parent_tag);
+        if (b == a)
+            return true;
+    }
+    while (a && b && a->parent_tag != b->parent_tag)
+    {
+        a = er_get_node(a->parent_tag);
+        b = er_get_node(b->parent_tag);
+    }
+    if (!a || !b || a == b)
+        return false;
+    const ERNode* parent = er_get_node(a->parent_tag);
+    return parent && paint_index(parent, a) < paint_index(parent, b);
+}
+
+static bool rect_contains(const ERRect* outer, const ERRect* inner)
+{
+    return inner->w <= 0 || inner->h <= 0
+           || (inner->x >= outer->x && inner->y >= outer->y && inner->x + inner->w <= outer->x + outer->w
+               && inner->y + inner->h <= outer->y + outer->h);
+}
+
+static bool layer_flag_listed(const ERNode* n, ERNode* const* list, int count)
+{
+    for (int i = 0; i < count; i++)
+        if (list[i] == n)
+            return true;
+    return false;
+}
+
+/**
+ * @brief Decides which images the host draws this commit and flags them, damaging every node whose flag
+ *        changes; publishes the layer list.
+ *
+ * A layer at full opacity hides everything painted under it, so clearing its rect loses nothing. One
+ * below full opacity is exact only over a layer the host also draws: the preceding sibling of its chain
+ * (nothing is painted between the two) and, through it, an opaque layer covering its visible rect.
+ * Runs before the damage pre-pass, so the flag changes it damages repaint in this same commit.
+ */
+static void update_layers(void)
+{
+    LayerCandidate cand[ERUI_MAX_LAYERS];
+    int count = 0;
+    if (s_layers_enabled && er_blit_can_clear() && s_display_buffer_count == 1)
+    {
+        for (uint16_t tag = 0U; tag < (uint16_t)ERUI_MAX_NODES && count < ERUI_MAX_LAYERS; tag++)
+        {
+            ERNode* n = er_get_node(tag);
+            if (n && n->type == ER_NODE_IMAGE && n->props.image.layer && layer_candidate(n, &cand[count]))
+                count++;
+        }
+    }
+    /* Paint order, by insertion: a handful of layers at most. */
+    for (int i = 1; i < count; i++)
+    {
+        const LayerCandidate key = cand[i];
+        int j = i - 1;
+        for (; j >= 0 && paints_before(key.image, cand[j].image); j--)
+            cand[j + 1] = cand[j];
+        cand[j + 1] = key;
+    }
+
+    ERNode* flagged[ERUI_MAX_LAYERS * (LAYER_CHAIN_MAX + 1)];
+    int flagged_count = 0;
+    s_layer_count = 0;
+    bool previous_active = false;
+    ERRect cover = {0, 0, 0, 0};
+    for (int i = 0; i < count; i++)
+    {
+        const LayerCandidate* c = &cand[i];
+        bool active = false;
+        if (c->alpha == 255U)
+        {
+            active = true;
+            cover = c->clip;
+        }
+        else if (previous_active)
+        {
+            const ERNode* top = layer_top(c);
+            const ERNode* below = layer_top(&cand[i - 1]);
+            const ERNode* parent = er_get_node(top->parent_tag);
+            active = parent && below->parent_tag == top->parent_tag
+                     && paint_index(parent, below) + 1 == paint_index(parent, top) && rect_contains(&cover, &c->clip);
+        }
+        previous_active = active;
+        if (!active)
+            continue;
+        flagged[flagged_count++] = c->image;
+        for (int k = 0; k < c->chain_len; k++)
+            flagged[flagged_count++] = c->chain[k];
+        ERLayer* l = &s_layers[s_layer_count++];
+        l->image = c->image->props.image.image_name;
+        l->pixels = (const uint32_t*)c->entry->buf;
+        l->image_w = c->entry->w;
+        l->image_h = c->entry->h;
+        l->src_x = c->src_x;
+        l->src_y = c->src_y;
+        l->src_w = c->src_w;
+        l->src_h = c->src_h;
+        l->dst = c->dst;
+        l->clip = c->clip;
+        l->alpha = c->alpha;
+    }
+
+    /* A node changing between rasterized and drawn by the host repaints its box either way. */
+    for (int i = 0; i < s_layer_flagged_count; i++)
+    {
+        ERNode* n = er_node_deref(s_layer_flagged[i]);
+        if (!n || layer_flag_listed(n, flagged, flagged_count))
+            continue;
+        if (n->layer_active || n->layer_wrapper)
+            er_mark_dirty_upward(n);
+        n->layer_active = n->layer_wrapper = false;
+    }
+    for (int i = 0; i < flagged_count; i++)
+    {
+        ERNode* n = flagged[i];
+        const bool image = (n->type == ER_NODE_IMAGE);
+        if (image ? !n->layer_active : !n->layer_wrapper)
+            er_mark_dirty_upward(n);
+        n->layer_active = image;
+        n->layer_wrapper = !image;
+        s_layer_flagged[i] = er_node_ref(n);
+    }
+    s_layer_flagged_count = flagged_count;
+}
