+/** @brief A container that draws nothing itself but may carry opacity: what a layer's chain is made of. */
+static bool layer_chain_link(const ERNode* a, const ERNode* child)
+{
+    if (a->type != ER_NODE_VIEW && a->type != ER_NODE_PRESSABLE)
+        return false;
+#if ERUI_TRANSFORMS_FULL
+    if (er_node_has_complex_transform(a))
+        return false;
+#endif
+    const ERViewProps* vp = &a->props.view;
+    if (vp->shadow_opacity > 0.0f || vp->elevation != 0U || (vp->background_color >> 24) != 0U)
+        return false;
+#if ERUI_GRADIENT
+    if (vp->gradient_type != ER_GRADIENT_NONE && vp->gradient_stop_count >= 2U)
+        return false;
+#endif
+    if (vp->border_width > 0 || vp->border_left_width > 0 || vp->border_top_width > 0 || vp->border_right_width > 0
+        || vp->border_bottom_width > 0)
+        return false;
+    return a->first_child_tag == child->tag && child->next_sibling_tag == ER_INVALID_TAG;
+}
