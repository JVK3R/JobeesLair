+void er_blit_clear(int x, int y, int w, int h)
+{
+    NRCtx* const ctx = rc();
+    if (!apply_clip(ctx, &x, &y, &w, &h))
+        return;
+    if (ctx->scratch_buf)
+    {
+        const int x0 = x - ctx->scratch_ox < 0 ? 0 : x - ctx->scratch_ox;
+        const int y0 = y - ctx->scratch_oy < 0 ? 0 : y - ctx->scratch_oy;
+        const int x1 = x + w - ctx->scratch_ox > ctx->scratch_w ? ctx->scratch_w : x + w - ctx->scratch_ox;
+        const int y1 = y + h - ctx->scratch_oy > ctx->scratch_h ? ctx->scratch_h : y + h - ctx->scratch_oy;
+        for (int row = y0; row < y1; row++)
+            for (int col = x0; col < x1; col++)
+                ctx->scratch_buf[(size_t)row * ctx->scratch_w + col] = 0U;
+        return;
+    }
+    if (g_backend && g_backend->clear_rect && g_backend->band_height == 0)
+    {
+        ER_BLIT_PERF_BEGIN();
+        g_backend->clear_rect(x, y, w, h, g_backend->ctx);
+        ER_BLIT_PERF_END(w, h);
+    }
+}
+
+bool er_blit_can_clear(void)
+{
+    return g_backend && g_backend->clear_rect && g_backend->band_height == 0;
+}
+
 bool er_blit_can_move(void)
 {
     return g_backend && g_backend->move_rect && g_backend->band_height == 0;
