+/*
+ * Host layers (er_set_layers_enabled), on the software backend.
+ *
+ * A crossfade of two layer images under a translucent overlay: the framebuffer drawn over the listed layers
+ * must look like the same scene rasterized with layers off, at every step of the fade; the fade itself must
+ * paint nothing; and a translucent layer with no opaque layer directly under it must be rasterized.
+ */
+
+#include "er_scene.h"
+#include "native_renderer.h"
+#include "software_backend.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define FB_W 160
+#define FB_H 120
+
+/* The engine's active backend, as the damage tracker on the hosts reads it (core/renderer_internal.h). */
+const EmbeddedRenderBackend* er_backend(void);
+
+static EmbeddedRenderBackend g_inner, g_counting;
+static long g_painted_px = 0;
+static int g_failures = 0;
+
+static void fill_cb(uint32_t argb, int x, int y, int w, int h, void* ctx)
+{
+    g_inner.fill_rect(argb, x, y, w, h, ctx);
+    g_painted_px += (long)w * h;
+}
+
+static void copy_cb(const void* src, int stride, int x, int y, int w, int h, void* ctx)
+{
+    g_inner.copy_rect(src, stride, x, y, w, h, ctx);
+    g_painted_px += (long)w * h;
+}
+
+static void blend_cb(const void* src, int stride, uint8_t alpha, int x, int y, int w, int h, void* ctx)
+{
+    g_inner.blend_rect(src, stride, alpha, x, y, w, h, ctx);
+    g_painted_px += (long)w * h;
+}
+
+static void clear_cb(int x, int y, int w, int h, void* ctx)
+{
+    g_inner.clear_rect(x, y, w, h, ctx);
+    g_painted_px += (long)w * h;
+}
+
+static const uint32_t s_red[4] = {0xFFC02010U, 0xFFC02010U, 0xFFC02010U, 0xFFC02010U};
+static const uint32_t s_blue[4] = {0xFF1040D0U, 0xFF1040D0U, 0xFF1040D0U, 0xFF1040D0U};
+
+/* Setting the backend forces a full repaint and also empties the image registry. */
+static void install(void)
+{
+    embedded_renderer_set_backend(&g_counting);
+    er_image_load("red", s_red, 2, 2);
+    er_image_load("blue", s_blue, 2, 2);
+}
+
+static void fail(const char* what)
+{
+    fprintf(stderr, "FAIL %s\n", what);
+    g_failures++;
+}
+
+static ERNode* node(ERNodeType type, ERNode* parent, int left, int top, int w, int h, uint32_t bg)
+{
+    ERNode* n = er_node_create(type);
+    ERProps p;
+    er_props_default(&p);
+    p.position = parent ? ER_POS_ABSOLUTE : p.position;
+    p.left = (int16_t)left;
+    p.top = (int16_t)top;
+    p.width = (int16_t)w;
+    p.height = (int16_t)h;
+    p.background_color = bg;
+    er_node_set_props(n, &p);
+    if (parent)
+        er_tree_append_child(parent, n);
+    return n;
+}
+
+/* A layer image in its own wrapper, the way a crossfading backdrop holds each image. */
+static ERNode* layer(ERNode* parent, const char* image, ERNode** wrapper)
+{
+    *wrapper = node(ER_NODE_VIEW, parent, 0, 0, 120, 80, 0);
+    ERNode* n = er_node_create(ER_NODE_IMAGE);
+    ERProps p;
+    er_props_default(&p);
+    p.width = 120;
+    p.height = 80;
+    p.resize_mode = ER_RESIZE_STRETCH;
+    p.layer = 1;
+    strncpy(p.image_name, image, ER_IMAGE_NAME_MAX);
+    er_node_set_props(n, &p);
+    er_tree_append_child(*wrapper, n);
+    return n;
+}
+
+/* The framebuffer pixel as a host presents it: the layers (solid images here, so sampling is exact)
+ * under the framebuffer, premultiplied source-over. */
+static uint32_t presented(int x, int y)
+{
+    const uint32_t ui = er_software_framebuffer()[y * FB_W + x];
+    int count = 0;
+    const ERLayer* layers = er_get_layers(&count);
+    uint32_t rgb[3] = {0, 0, 0};
+    for (int i = 0; i < count; i++)
+    {
+        const ERLayer* l = &layers[i];
+        if (x < l->clip.x || y < l->clip.y || x >= l->clip.x + l->clip.w || y >= l->clip.y + l->clip.h)
+            continue;
+        if (x < l->dst.x || y < l->dst.y || x >= l->dst.x + l->dst.w || y >= l->dst.y + l->dst.h)
+            continue;
+        const uint32_t texel = l->pixels[0];
+        for (int c = 0; c < 3; c++)
+            rgb[c] = (((texel >> (8 * c)) & 0xFFU) * l->alpha + rgb[c] * (255U - l->alpha) + 127U) / 255U;
+    }
+    const uint32_t inv = 255U - (ui >> 24);
+    uint32_t out = 0xFF000000U;
+    for (int c = 0; c < 3; c++)
+        out |= (((ui >> (8 * c)) & 0xFFU) + (rgb[c] * inv + 127U) / 255U) << (8 * c);
+    return out;
+}
+
+/** @brief Compares what the host presents with the same scene rasterized with layers off. */
+static void check_presented(const char* what)
+{
+    static uint32_t shown[FB_W * FB_H];
+    for (int y = 0; y < FB_H; y++)
+        for (int x = 0; x < FB_W; x++)
+            shown[y * FB_W + x] = presented(x, y);
+
+    er_set_layers_enabled(false);
+    install();
+    er_commit();
+    int worst = 0, wx = 0, wy = 0;
+    for (int y = 0; y < FB_H; y++)
+        for (int x = 0; x < FB_W; x++)
+            for (int c = 0; c < 24; c += 8)
+            {
+                const int a = (int)((shown[y * FB_W + x] >> c) & 0xFFU);
+                const int b = (int)((er_software_framebuffer()[y * FB_W + x] >> c) & 0xFFU);
+                if (abs(a - b) > worst)
+                {
+                    worst = abs(a - b);
+                    wx = x;
+                    wy = y;
+                }
+            }
+    /* Each side rounds its own blends once or twice; anything past that is a wrong pixel. */
+    if (worst > 2)
+    {
+        fprintf(stderr, "FAIL %s: off by %d at (%d,%d)\n", what, worst, wx, wy);
+        g_failures++;
+    }
+    er_set_layers_enabled(true);
+    install();
+    er_commit();
+}
+
+int main(void)
+{
+    if (!er_software_backend_init(FB_W, FB_H))
+        return 1;
+    g_inner = *er_backend();
+    g_counting = g_inner;
+    g_counting.fill_rect = fill_cb;
+    g_counting.copy_rect = copy_cb;
+    g_counting.blend_rect = blend_cb;
+    g_counting.clear_rect = clear_cb;
+    install();
+    er_reset();
+
+    ERNode* root = node(ER_NODE_VIEW, NULL, 0, 0, FB_W, FB_H, 0xFF203040U);
+    ERNode* backdrop = node(ER_NODE_VIEW, root, 20, 10, 120, 80, 0);
+    ERNode *wrap_a, *wrap_b;
+    ERNode* image_a = layer(backdrop, "red", &wrap_a);
+    layer(backdrop, "blue", &wrap_b);
+    node(ER_NODE_VIEW, root, 0, 50, FB_W, 30, 0x80FFFFFFU); /* translucent overlay across both */
+    const ERAnimValueHandle fade = er_anim_value_create(0.0f);
+    er_anim_value_bind(fade, wrap_b, ER_PROP_OPACITY);
+    er_tree_set_root(root);
+    er_set_layers_enabled(true);
+    er_commit();
+
+    int count = 0;
+    const ERLayer* layers = er_get_layers(&count);
+    if (count != 2 || strcmp(layers[0].image, "red") != 0 || strcmp(layers[1].image, "blue") != 0)
+        fail("both images are layers, bottom first");
+    else if (layers[0].alpha != 255U || layers[1].alpha != 0U || layers[0].dst.x != 20 || layers[0].dst.y != 10
+             || layers[0].dst.w != 120 || layers[0].dst.h != 80)
+        fail("layer geometry and opacity");
+    const uint32_t* fb = er_software_framebuffer();
+    if (fb[20 * FB_W + 40] != 0U)
+        fail("a layer leaves its rect transparent");
+    if ((fb[60 * FB_W + 40] >> 24) != 0x80U || (fb[60 * FB_W + 4] >> 24) != 0xFFU)
+        fail("the overlay keeps its coverage over a layer and stays opaque elsewhere");
+    check_presented("start of the fade");
+
+    for (int step = 1; step <= 4; step++)
+    {
+        g_painted_px = 0;
+        er_anim_value_set(fade, (float)step / 4.0f);
+        er_commit();
+        layers = er_get_layers(&count);
+        if (g_painted_px != 0)
+            fail("a layer's fade repaints nothing");
+        if (count != 2 || layers[1].alpha != (uint8_t)((float)step / 4.0f * 255.0f + 0.5f))
+        {
+            fprintf(stderr, "FAIL step %d: %d layers, top alpha %d\n", step, count, count > 1 ? layers[1].alpha : -1);
+            g_failures++;
+        }
+        check_presented("during the fade");
+    }
+
+    /* Without the opaque layer under it, the half-faded image has to be rasterized over what is there. */
+    er_anim_value_set(fade, 0.5f);
+    er_commit();
+    er_tree_remove_child(backdrop, wrap_a);
+    er_node_destroy(wrap_a);
+    (void)image_a;
+    er_commit();
+    layers = er_get_layers(&count);
+    if (count != 0)
+        fail("a translucent layer with nothing opaque under it is rasterized");
+    check_presented("translucent image rasterized again");
+
+    /* Back at full opacity it is a layer again. */
+    er_anim_value_set(fade, 1.0f);
+    er_commit();
+    layers = er_get_layers(&count);
+    if (count != 1 || layers[0].alpha != 255U)
+        fail("an opaque image becomes a layer again");
+    check_presented("single opaque layer");
+
+    /* Something painted between the two would show through the upper one: it is rasterized. */
+    ERNode* wrap_c;
+    node(ER_NODE_VIEW, backdrop, 30, 30, 20, 20, 0xFF00FF00U);
+    layer(backdrop, "red", &wrap_c);
+    ERProps cp;
+    er_props_default(&cp);
+    cp.position = ER_POS_ABSOLUTE;
+    cp.width = 120;
+    cp.height = 80;
+    cp.opacity = 128;
+    er_node_set_props(wrap_c, &cp);
+    er_commit();
+    layers = er_get_layers(&count);
+    if (count != 1)
+        fail("a translucent layer over other content is rasterized");
+    check_presented("translucent layer over other content");
+
+    if (g_failures == 0)
+        printf("PASS test_layers\n");
+    return g_failures == 0 ? 0 : 1;
+}
