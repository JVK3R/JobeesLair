+/**
+ * Runs `fn` in one React batch, as React Native's unstable_batchedUpdates does: its state updates
+ * render once, when it returns, instead of once each. For callbacks the host makes outside the
+ * batcher above, such as a per-frame callback that several components update from.
+ * @template T @param {() => T} fn @returns {T}
+ */
+export function batchedUpdates(fn) {
+  return reconciler.batchedUpdates(fn);
+}
