+/**
+ * @brief Clears an image layer's box for the host to draw, except the radius-sized square at each rounded
+ *        corner, where the image is rasterized as usual with its anti-aliased edge.
+ */
+static void render_layer_hole(const ERImageProps* ip, int x, int y, int w, int h)
+{
+    int tl = ip->radius_tl, tr = ip->radius_tr, br = ip->radius_br, bl = ip->radius_bl;
+    er_rrect_clamp_radii(w, h, &tl, &tr, &br, &bl);
+    /* Bands of rows, split wherever a corner square starts or ends. */
+    int cuts[6] = {0, tl, tr, h - bl, h - br, h};
+    for (int i = 1; i < 6; i++)
+        for (int j = i; j > 0 && cuts[j - 1] > cuts[j]; j--)
+        {
+            const int t = cuts[j];
+            cuts[j] = cuts[j - 1];
+            cuts[j - 1] = t;
+        }
+    for (int i = 0; i < 5; i++)
+    {
+        const int y0 = cuts[i], y1 = cuts[i + 1];
+        if (y1 <= y0)
+            continue;
+        const int left = y0 < tl ? tl : (y0 >= h - bl ? bl : 0);
+        const int right = y0 < tr ? tr : (y0 >= h - br ? br : 0);
+        if (w - left - right > 0)
+            er_blit_clear(x + left, y + y0, w - left - right, y1 - y0);
+    }
+    const int corner[4][3] = {{tl, 0, 0}, {tr, w - tr, 0}, {br, w - br, h - br}, {bl, 0, h - bl}};
+    for (int i = 0; i < 4; i++)
+        if (corner[i][0] > 0)
+        {
+            er_push_clip_rect(x + corner[i][1], y + corner[i][2], corner[i][0], corner[i][0]);
+            er_image_render(ip, x, y, w, h);
+            er_pop_clip_rect();
+        }
+}
+
