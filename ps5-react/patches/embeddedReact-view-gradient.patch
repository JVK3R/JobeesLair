+                    const uint32_t want = inside ? full[yy * FB_W + xx] : 0u;
+                    if (px(&tc, xx, yy) != want)
+                    {
+                        printf("  angle %.0f at (%d,%d): got %08X, want %08X\n", (double)angles[ai], xx, yy,
