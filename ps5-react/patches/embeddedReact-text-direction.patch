+/**
+ * @brief Resolves START and END against the paragraph direction to LEFT, CENTER or RIGHT.
+ *
+ * @param[in] align  ERTextAlign.
+ * @param[in] rtl    True for a right-to-left paragraph.
+ */
+static inline uint8_t er_text_physical_align(uint8_t align, bool rtl)
+{
+    if (align == ER_TEXT_ALIGN_START)
+        return rtl ? ER_TEXT_ALIGN_RIGHT : ER_TEXT_ALIGN_LEFT;
+    if (align == ER_TEXT_ALIGN_END)
+        return rtl ? ER_TEXT_ALIGN_LEFT : ER_TEXT_ALIGN_RIGHT;
+    return align;
+}
