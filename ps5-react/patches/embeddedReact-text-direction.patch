+/**
+ * @brief True when @p n lays its children out right to left (ERDirection, inherited).
+ *
+ * A row then runs from the right edge, as row-reverse does, and a column's cross axis starts at the
+ * right. A scroll container keeps left-to-right order: its content cannot scroll to negative offsets.
+ *
+ * @param[in] n  Container node.
+ *
+ * @return true when the nearest node at or above @p n that sets a direction sets RTL.
+ */
+static bool layout_rtl(const ERNode* n)
+{
+    if (n->layout.overflow == ER_OVERFLOW_SCROLL)
+        return false;
+    for (const ERNode* a = n; a; a = er_get_node(a->parent_tag))
+        if (a->layout.direction != ER_DIRECTION_INHERIT)
+            return a->layout.direction == ER_DIRECTION_RTL;
+    return false;
+}
