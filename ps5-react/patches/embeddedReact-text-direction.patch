+/**
+ * @brief The paragraph direction text in @p n is drawn with: its writingDirection, else the
+ *        direction of the nearest node at or above it that sets one, else INHERIT (auto).
+ */
+static uint8_t text_direction(const ERNode* n)
+{
+    if (n->type == ER_NODE_TEXT && n->props.text.writing_direction != ER_DIRECTION_INHERIT)
+        return n->props.text.writing_direction;
+    for (const ERNode* a = n; a; a = er_get_node(a->parent_tag))
+        if (a->layout.direction != ER_DIRECTION_INHERIT)
+            return a->layout.direction;
+    return ER_DIRECTION_INHERIT;
+}
