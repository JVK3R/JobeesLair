+}
+
+/** @brief Marks, joiners and modifiers drawn as part of the character before them. */
+static bool utf8_extends(uint32_t c)
+{
+    static const uint32_t ranges[][2] = {
+        {0x0300, 0x036F}, {0x0483, 0x0489}, {0x0591, 0x05BD}, {0x05BF, 0x05C7}, {0x0610, 0x061A},
+        {0x064B, 0x065F}, {0x0670, 0x0670}, {0x06D6, 0x06ED}, {0x0900, 0x0903}, {0x093A, 0x094F},
+        {0x0951, 0x0957}, {0x0962, 0x0963}, {0x0981, 0x0983}, {0x09BC, 0x09BC}, {0x09BE, 0x09D7},
+        {0x09E2, 0x09E3}, {0x09FE, 0x09FE}, {0x0A01, 0x0A03}, {0x0A3C, 0x0A51}, {0x0A70, 0x0A71},
+        {0x0A75, 0x0A75}, {0x0A81, 0x0A83}, {0x0ABC, 0x0ACD}, {0x0B01, 0x0B03}, {0x0B3C, 0x0B57},
+        {0x0BBE, 0x0BCD}, {0x0C00, 0x0C04}, {0x0C3C, 0x0C56}, {0x0C81, 0x0C83}, {0x0CBC, 0x0CD6},
+        {0x0D00, 0x0D03}, {0x0D3B, 0x0D57}, {0x1AB0, 0x1AFF}, {0x1DC0, 0x1DFF}, {0x200C, 0x200D},
+        {0x20D0, 0x20FF}, {0x3099, 0x309A}, {0xFE00, 0xFE0F}, {0xFE20, 0xFE2F}, {0x1F3FB, 0x1F3FF},
+        {0xE0020, 0xE007F}, {0xE0100, 0xE01EF},
+    };
+    for (size_t i = 0; i < sizeof(ranges) / sizeof(ranges[0]); i++)
+        if (c >= ranges[i][0] && c <= ranges[i][1])
+            return true;
+    return false;
+}
+
+/** @brief A virama (Devanagari to Malayalam) or zero-width joiner: it joins the next character to its conjunct. */
+static bool utf8_joins_next(uint32_t c)
+{
+    return c == 0x200DU || (c >= 0x0900U && c <= 0x0D7FU && (c & 0x7FU) == 0x4DU);
+}
+
+size_t er_utf8_clip(const char* text, size_t max_bytes)
+{
+    const uint8_t* s = (const uint8_t*)text;
+    size_t n = 0;
+    while (n < max_bytes && s[n])
+        n++;
+    size_t end = n;
+    if (n > 0U)
+    {
+        /* The last codepoint must be whole. */
+        const size_t lead = utf8_previous(s, n);
+        const uint8_t b = s[lead];
+        const size_t need = (b >= 0xF0U) ? 4U : (b >= 0xE0U) ? 3U : (b >= 0xC0U) ? 2U : 1U;
+        if (n - lead < need)
+            end = lead;
+    }
+    if (end == n && !s[n])
+        return n;
+    /* Text was dropped: also drop the start of a grapheme cluster or conjunct it continues. */
+    while (end > 0U)
+    {
+        const size_t previous = utf8_previous(s, end);
+        if (!utf8_extends(utf8_at(s, end)) && !utf8_joins_next(utf8_at(s, previous)))
+            break;
+        end = previous;
+    }
+    return end;
 }
 
