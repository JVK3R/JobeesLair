+/** @brief Start of the codepoint that ends just before byte @p i (> 0). */
+static size_t utf8_previous(const uint8_t* s, size_t i)
+{
+    size_t lead = i - 1U;
+    while (lead > 0U && i - lead < 4U && (s[lead] & 0xC0U) == 0x80U)
         lead--;
-    if (lead == 0 || (uint8_t)s[lead - 1] < 0xC0U)
-        return;
-    const uint8_t b = (uint8_t)s[lead - 1];
-    const size_t need = (b >= 0xF0U) ? 4U : (b >= 0xE0U) ? 3U : 2U;
-    if (n - (lead - 1) < need)
-        s[lead - 1] = '\0';
