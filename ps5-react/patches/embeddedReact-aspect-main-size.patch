 static void measure_content(const uint16_t tag, const int16_t avail_w, int16_t* out_w, int16_t* out_h);
+
+/** Rounds a size derived through aspect_ratio to whole pixels within the int16 range. */
+static int16_t aspect_px(const float v)
+{
+    return v >= (float)INT16_MAX ? INT16_MAX : (v <= 0.0f ? 0 : (int16_t)(v + 0.5f));
+}
 
