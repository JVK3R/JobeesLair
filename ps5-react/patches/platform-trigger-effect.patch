@@ -122,6 +143,33 @@ void Pad::set_light_bar(std::uint8_t r, std::uint8_t g, std::uint8_t b)
         sys::log("[HUI] pad scePadSetLightBar=0x%08x", static_cast<unsigned>(result));
 }
 
+int Pad::set_trigger_effect(unsigned mask, unsigned mode, const std::uint8_t *data, std::size_t size)
+{
+    if (handle_ < 0 || (mask & 3u) == 0)
+        return -1;
+    TriggerEffect effect{};
+    effect.mask = static_cast<std::uint8_t>(mask & 3u);
+    for (TriggerCommand &command : effect.command)
+    {
+        command.mode = mode;
+        for (std::size_t i = 0; i < size && i < sizeof command.data; ++i)
+            command.data[i] = data[i];
+    }
+    const int result = scePadSetTriggerEffect(handle_, &effect);
+    if (result != 0)
+        sys::log("[HUI] pad scePadSetTriggerEffect=0x%08x", static_cast<unsigned>(result));
+    return result;
+}
+
+void Pad::set_trigger_feedback(unsigned mask, int position, int strength)
+{
+    const std::uint8_t data[2] = {
+        static_cast<std::uint8_t>(position < 0 ? 0 : position > 9 ? 9 : position),
+        static_cast<std::uint8_t>(strength > 8 ? 8 : strength),
+    };
+    set_trigger_effect(mask, strength > 0 ? 1u : 0u, data, strength > 0 ? sizeof data : 0);
+}
