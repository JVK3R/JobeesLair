+
+/*
+ * Scaled images and gradients wider than the row buffer (ERUI_MAX_IMG_ROW_PIXELS) render in full.
+ *
+ * Each case renders a box more than two row buffers wide, starting left of the framebuffer, once under a
+ * full-width clip and once in clip strips narrower than the row buffer. Every column must be painted, and
+ * the two renders must match pixel for pixel, so the chunk seams are invisible.
+ */
+
+#include "er_limits.h"
+#include "er_scene.h"
+#include "gradient.h"
+#include "image_scaler.h"
+#include "native_renderer.h"
+#include "renderer_internal.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define FB_W (2 * ERUI_MAX_IMG_ROW_PIXELS + 300)
+#define FB_H 16
+#define BOX_X (-37)
+#define BOX_W (FB_W + 80)
+#define STRIP 97
+#define SRC_W 64
+#define SRC_H 8
+
+static uint32_t s_fb[FB_W * FB_H];
+static uint32_t s_full[FB_W * FB_H];
+static uint32_t s_src[SRC_W * SRC_H];
+static int g_failures = 0;
+
+static void fill_cb(uint32_t argb, int x, int y, int w, int h, void* ctx)
+{
+    (void)ctx;
+    for (int py = y; py < y + h; py++)
+        for (int px = x; px < x + w; px++)
+            if (px >= 0 && py >= 0 && px < FB_W && py < FB_H)
+                s_fb[py * FB_W + px] = argb;
+}
+
+static void copy_cb(const void* src, int stride, int x, int y, int w, int h, void* ctx)
+{
+    (void)ctx;
+    for (int row = 0; row < h; row++)
+    {
+        const uint32_t* s = (const uint32_t*)((const uint8_t*)src + (size_t)row * (size_t)stride);
+        for (int col = 0; col < w; col++)
+            if (x + col >= 0 && y + row >= 0 && x + col < FB_W && y + row < FB_H)
+                s_fb[(y + row) * FB_W + x + col] = s[col];
+    }
+}
+
+static void blend_cb(const void* src, int stride, uint8_t alpha, int x, int y, int w, int h, void* ctx)
+{
+    (void)alpha;
+    copy_cb(src, stride, x, y, w, h, ctx);
+}
+
+typedef void (*RenderFn)(void);
+
+static ERImageProps s_image;
+static ERViewProps s_view;
+
+static void render_image(void)
+{
+    er_image_render(&s_image, BOX_X, 0, BOX_W, FB_H);
+}
+
+static void render_gradient(void)
+{
+    er_gradient_render(&s_view, BOX_X, 0, BOX_W, FB_H);
+}
+
+static void check(const char* what, RenderFn render)
+{
+    memset(s_fb, 0, sizeof(s_fb));
+    er_push_clip_rect(0, 0, FB_W, FB_H);
+    render();
+    er_pop_clip_rect();
+    memcpy(s_full, s_fb, sizeof(s_full));
+
+    memset(s_fb, 0, sizeof(s_fb));
+    for (int x = 0; x < FB_W; x += STRIP)
+    {
+        er_push_clip_rect(x, 0, STRIP, FB_H);
+        render();
+        er_pop_clip_rect();
+    }
+
+    for (int x = 0; x < FB_W; x++)
+    {
+        if (s_full[(FB_H / 2) * FB_W + x] == 0U)
+        {
+            fprintf(stderr, "FAIL %s: column %d of %d not painted (row buffer %d)\n", what, x, FB_W,
+                    ERUI_MAX_IMG_ROW_PIXELS);
+            g_failures++;
+            return;
+        }
+    }
+    for (int i = 0; i < FB_W * FB_H; i++)
+    {
+        if (s_full[i] != s_fb[i])
+        {
+            fprintf(stderr, "FAIL %s: (%d,%d) is %08x in one pass, %08x in strips\n", what, i % FB_W, i / FB_W,
+                    s_full[i], s_fb[i]);
+            g_failures++;
+            return;
+        }
+    }
+}
+
+int main(void)
+{
+    static EmbeddedRenderBackend be;
+    be.fill_rect = fill_cb;
+    be.copy_rect = copy_cb;
+    be.blend_rect = blend_cb;
+    embedded_renderer_set_backend(&be);
+
+    /* Every source column a different colour, so a column sampled from the wrong place shows. */
+    for (int y = 0; y < SRC_H; y++)
+        for (int x = 0; x < SRC_W; x++)
+            s_src[y * SRC_W + x] = 0xFF000000U | ((uint32_t)(x * 4) << 16) | ((uint32_t)(y * 30) << 8) | (uint32_t)(255 - x * 4);
+    er_image_load("wide", s_src, SRC_W, SRC_H);
+
+    strncpy(s_image.image_name, "wide", ER_IMAGE_NAME_MAX);
+    s_image.resize_mode = ER_RESIZE_STRETCH;
+    check("stretched image", render_image);
+    s_image.resize_mode = ER_RESIZE_COVER;
+    check("cover image", render_image);
+    s_image.tint_color = 0xFF80C040U;
+    check("tinted image", render_image);
+    s_image.tint_color = 0U;
+    s_image.radius_tl = s_image.radius_tr = s_image.radius_br = s_image.radius_bl = 6;
+    check("rounded image", render_image);
+
+#if ERUI_GRADIENT
+    s_view.gradient_type = ER_GRADIENT_LINEAR;
+    s_view.gradient_stop_count = 3;
+    s_view.gradient_stops[0] = (ERGradientStop){0xFF0000FFU, 0.0f};
+    s_view.gradient_stops[1] = (ERGradientStop){0xC000FF00U, 0.5f};
+    s_view.gradient_stops[2] = (ERGradientStop){0xFFFF0000U, 1.0f};
+    s_view.gradient_angle = 90.0f;
+    check("horizontal gradient", render_gradient);
+    s_view.gradient_angle = 30.0f;
+    check("diagonal gradient", render_gradient);
+    s_view.border_radius = 6;
+    check("rounded gradient", render_gradient);
+    s_view.border_radius = 0;
+#if ERUI_GRADIENT_RADIAL
+    s_view.gradient_type = ER_GRADIENT_RADIAL;
+    check("radial gradient", render_gradient);
+#endif
+#endif
+
+    if (g_failures)
+        return EXIT_FAILURE;
+    printf("PASS: rows %d px wide render in full across a %d px row buffer\n", FB_W, ERUI_MAX_IMG_ROW_PIXELS);
+    return EXIT_SUCCESS;
+}
