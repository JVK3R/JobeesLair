
# The homebrew index builder's cache (tools/homebrew/build-index.mjs); CI keeps it in the Actions cache.
homebrew/cache.json

# Python bytecode from the brand scripts
__pycache__/

# Per-build private files (app/data/private/README.txt): the bug report webhook
app/data/private/*
!app/data/private/README.txt

# wrangler state of the Workers (tools/report-relay, tools/online): its cache names the Cloudflare account
tools/*/.wrangler/
tools/*/.dev.vars
